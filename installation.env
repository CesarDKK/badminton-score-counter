# ============================================================
# INSTALLATION KONFIGURATION
# ============================================================
# APP_DOMAIN: Domænet appen kører på.
# Adgang via IP-adresse eller localhost behandles automatisk
# som direkte/lokal adgang uanset denne indstilling.
#
# Denne fil er committet og må KUN indeholde ikke-hemmelige værdier.
# Alle adgangskoder og JWT-nøgler (også football-modulets) sættes i den
# lokale, ikke-committede .env på serveren — se .env.example.
# ============================================================
APP_DOMAIN=badmintonapp.dk
