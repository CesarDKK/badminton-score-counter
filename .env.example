# ============================================================
# HEMMELIGHEDER — kopiér til .env og skift ALLE værdier
# ============================================================
# .env er i .gitignore og uploades aldrig til GitHub.
# docker-compose kræver at hver af disse er sat (ingen usikre standardværdier),
# så en manglende værdi giver en tydelig fejl ved opstart i stedet for en
# kendt-standard adgangskode i produktion.

# --- Badminton (hoved-app) ---
MYSQL_ROOT_PASSWORD=skift_til_en_lang_tilfaeldig_vaerdi
MYSQL_PASSWORD=skift_til_en_anden_lang_tilfaeldig_vaerdi
JWT_SECRET=mindst_32_tegn_lang_tilfaeldig_hemmelig_noegle

# --- Football-modul (footballapp.dk) ---
# Har sit EGET JWT-secret (må ikke være det samme som badmintons) og sin
# egen DB-bruger. Football-admins oprettes separat med seedClub.js — der er
# ingen admin-adgangskode her.
FOOTBALL_DB_PASSWORD=skift_til_en_lang_tilfaeldig_vaerdi
FOOTBALL_JWT_SECRET=mindst_32_tegn_lang_tilfaeldig_hemmelig_noegle_til_football
