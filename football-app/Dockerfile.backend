FROM node:22-alpine

WORKDIR /app

# Landeflag-SVG'erne (hampusborgos/country-flags, public domain) ligger i
# backend/static-flags/ og følger med "COPY backend/ ./" til /app/static-flags/.
# De kopieres til volume ved første startup, da /app/uploads/ er et docker-volume
# der maskerer image-content.

COPY backend/package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY backend/ ./

RUN mkdir -p /app/uploads/logos

ENV PORT=3001
EXPOSE 3001

CMD ["node", "server.js"]
