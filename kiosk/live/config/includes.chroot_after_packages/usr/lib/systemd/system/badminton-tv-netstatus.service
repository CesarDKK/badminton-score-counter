# Skriver netværksstatus til startsiden (/run/badminton-tv/status.js), så den
# kan vise hvorfor WiFi ikke forbinder.
[Unit]
Description=Badminton TV: netværksstatus til skærmen
After=NetworkManager.service badminton-tv-setup.service
ConditionKernelCommandLine=!badminton.tilstand=installer
ConditionKernelCommandLine=!badminton.tilstand=hentlog

[Service]
Type=simple
ExecStart=/usr/lib/badminton-tv/netstatus
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
