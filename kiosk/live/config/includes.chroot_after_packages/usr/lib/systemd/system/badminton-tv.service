# Chromium i fuldskærm under cage på tty1.
#
# PAMName=login + TTYPath giver brugeren tv en rigtig logind-session på seat0,
# som cage skal bruge for at få adgang til skærm og tastatur — uden autologin.
[Unit]
Description=Badminton TV (Chromium i fuldskærm)
After=systemd-user-sessions.service getty@tty1.service badminton-tv-setup.service badminton-tv-cec.service
Wants=badminton-tv-setup.service
Conflicts=getty@tty1.service
ConditionKernelCommandLine=!badminton.tilstand=installer

[Service]
Type=simple
User=tv
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -- /usr/lib/badminton-tv/browser
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
