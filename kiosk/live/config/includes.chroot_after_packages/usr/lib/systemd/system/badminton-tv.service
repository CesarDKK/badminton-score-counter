# Chromium i fuldskærm under cage på tty1.
#
# PAMName=login + TTYPath giver brugeren tv en rigtig logind-session på seat0,
# som cage skal bruge for at få adgang til skærm og tastatur — uden autologin.
[Unit]
Description=Badminton TV (Chromium i fuldskærm)
After=systemd-user-sessions.service getty@tty1.service badminton-tv-setup.service badminton-tv-cec.service
Wants=badminton-tv-setup.service
Conflicts=getty@tty1.service
ConditionKernelCommandLine=!badminton.tilstand=installer
ConditionKernelCommandLine=!badminton.tilstand=hentlog

[Service]
Type=simple
User=tv
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# En usynlig skærm (HEADLESS-1) ved siden af den rigtige. På nogle PC'er (fx
# DisplayPort med adapter) — og på en Pi — forsvinder skærmen helt for Linux,
# når TV'et er slukket. Uden nogen skærm starter Chromium slet ikke, så TV-siden
# og livstegnene til admin kom først, når TV'et blev tændt (set i Lyngby; i
# VM'en med video=Virtual-1:d). Den virtuelle skærm oprettes først, og
# -m last viser kun den sidst tilsluttede: TV'et, når det er der, ellers den
# virtuelle — også når TV'et slukkes og tændes, mens PC'en kører.
Environment=WLR_BACKENDS=headless,drm,libinput
Environment=WLR_HEADLESS_OUTPUTS=1
ExecStart=/usr/bin/cage -m last -- /usr/lib/badminton-tv/browser
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
