#!/bin/bash
# Tænder eller slukker TV'et over HDMI-CEC:
#   cec taend   — TV'et tænder og skifter til PC'ens indgang (ved opstart)
#   cec sluk    — TV'et går i standby (ved nedlukning)
#
# De fleste PC'er kan ikke CEC: grafikkortet har ikke CEC-benet forbundet.
# Linux-kernen opretter kun /dev/cecN, når hardwaren rent faktisk kan (fx et
# DisplayPort→HDMI-adapter med CEC-tunnel). Findes den ikke, gør vi ingenting —
# så må TV'et tændes med fjernbetjeningen. Scriptet afslutter altid med 0, så
# en manglende CEC aldrig forsinker eller stopper TV-visningen.
#
# Status skrives til /run/badminton-tv/cec-status og vises på startsiden:
#   ok | ingen-svar | ikke-fundet | fra

set -u
. /usr/lib/badminton-tv/conf.sh

STATUS=/run/badminton-tv/cec-status
mkdir -p /run/badminton-tv

status() { printf '%s\n' "$1" > "$STATUS"; echo "HDMI-CEC: $1${2:+ ($2)}"; }

if conf=$(bt_find_conf); then
    bt_read_conf "$conf"
else
    BT_CEC=auto
fi

if [ "$BT_CEC" = fra ]; then
    status fra
    exit 0
fi

# DisplayPort-CEC registreres først når grafikdriveren har læst skærmens EDID.
# Ved opstart giver vi den et par sekunder; ved nedlukning findes den allerede.
enhed=''
forsoeg=1
[ "${1:-}" = taend ] && forsoeg=6
for ((i = 0; i < forsoeg; i++)); do
    for d in /dev/cec*; do
        [ -c "$d" ] && { enhed=$d; break 2; }
    done
    sleep 0.5
done

if [ -z "$enhed" ]; then
    status ikke-fundet
    exit 0
fi

# Meld PC'en på CEC-bussen som afspiller. Uden en logisk adresse må vi ikke
# sende kommandoer.
cec-ctl -d "$enhed" --playback >/dev/null 2>&1

fysisk=$(cec-ctl -d "$enhed" 2>/dev/null \
    | awk -F: '/Physical Address/ { gsub(/[[:space:]]/, "", $2); print $2; exit }')

case "${1:-}" in
    taend)
        if [ -z "$fysisk" ] || [ "$fysisk" = "f.f.f.f" ]; then
            # Enheden findes, men der er intet TV i den anden ende, eller
            # adapteren videresender ikke CEC.
            status ingen-svar "fysisk adresse ${fysisk:-ukendt}"
            exit 0
        fi
        if cec-ctl -d "$enhed" --to 0 --image-view-on >/dev/null 2>&1; then
            cec-ctl -d "$enhed" --to 0 --active-source "phys-addr=$fysisk" >/dev/null 2>&1
            status ok "$enhed, $fysisk"
        else
            status ingen-svar "$enhed svarede ikke på image-view-on"
        fi
        ;;
    sluk)
        cec-ctl -d "$enhed" --to 0 --standby >/dev/null 2>&1 \
            && echo "HDMI-CEC: standby sendt" \
            || echo "HDMI-CEC: standby blev ikke modtaget"
        ;;
    *)
        echo "Brug: $0 taend|sluk" >&2
        ;;
esac
exit 0
