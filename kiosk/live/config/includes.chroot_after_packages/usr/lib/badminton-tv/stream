def log(tekst):
    print(f'[stream] {tekst}', flush=True)


def laes_tekst(sti):
    try:
        with open(sti, encoding='utf-8', errors='replace') as f:
            return f.read().strip()
    except OSError:
        return ''


# Samme som rapport: (TV_URL, NAVN) fra setup's kiosk.env og (server, token)
def kiosk_env():
    try:
        ud = subprocess.run(
            ['bash', '-c', 'set -a; . "$1" 2>/dev/null; printf "%s\\0%s" "${BT_TV_URL:-}" "${BT_NAVN:-}"',
             'bash', KIOSK_ENV], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        ud = ''
    url, _, navn = ud.partition('\0')
    return url.strip(), navn.strip()


def adgangslink(tv_url):
    try:
        u = urllib.parse.urlsplit(tv_url)
    except ValueError:
        return None, None
    m = re.match(r'^/t/([A-Za-z0-9_-]{8,128})/?$', u.path or '')
    if u.scheme not in ('http', 'https') or not u.netloc or not m:
        return None, None
    return f'{u.scheme}://{u.netloc}', m.group(1)


# ---------- Kameraet ----------

def find_kamera():
    """(enhed, navn) for det første USB-kamera, eller (None, None)."""
    for sti in sorted(glob.glob(KAMERA_GLOB)):
        enhed = os.path.realpath(sti)
        navn = laes_tekst(f'/sys/class/video4linux/{os.path.basename(enhed)}/name')
        if not navn:
            # by-id-navnet: usb-046d_HD_Pro_Webcam_C920_1234-video-index0
            navn = re.sub(r'^usb-[0-9a-f]{4}_|_[0-9A-F]{6,}-video-index0$|-video-index0$', '',
                          os.path.basename(sti)).replace('_', ' ')
        return enhed, navn[:100]
    return None, None


def stil_kamera(enhed, autofokus=False):
    """50 Hz og fast fokus (eller autofokus) — kameraer, der ikke har indstillingen, springer den over."""
    fokus = (('focus_automatic_continuous=1', 'focus_auto=1') if autofokus else
             ('focus_automatic_continuous=0', 'focus_auto=0', 'focus_absolute=0'))
    for ctrl in ('power_line_frequency=1', *fokus):
        try:
            subprocess.run([V4L2CTL, '-d', enhed, '-c', ctrl], capture_output=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            pass


def kamera_formater(enhed):
    """Kameraets MJPEG-formater: {(bredde, hoejde): [billeder i sekundet, …]}, eller {} (ukendt)."""
    try:
        ud = subprocess.run([V4L2CTL, '-d', enhed, '--list-formats-ext'],
                            capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    formater, mjpeg, str_ = {}, False, None
    for linje in ud.splitlines():
        m = re.search(r"\[\d+\]: '(\w+)'", linje)
        if m:
            mjpeg, str_ = m.group(1) == 'MJPG', None
            continue
        if not mjpeg:
            continue
        m = re.search(r'Size: Discrete (\d+)x(\d+)', linje)
        if m:
            str_ = (int(m.group(1)), int(m.group(2)))
            formater.setdefault(str_, set())
            continue
        m = re.search(r'\(([\d.]+) fps\)', linje)
        if m and str_:
            formater[str_].add(round(float(m.group(1))))
    return {s: sorted(r) for s, r in formater.items() if r}


def vaelg_format(formater, bredde, hoejde, billeder):
    """((kamera-bredde, -højde), billeder, (sendt bredde, højde)): det valgte, eller det
    bedste, kameraet kan. Har kameraet ikke opløsningen, men en større i 16:9, skaleres
    den ned; ellers tages den største derunder. Opløsningen går forud for billederne:
    1080p med 60 valgt, kameraet kan 1080p med 30 og 720p med 60 → 1080p med 30.
    Billeder: de flest, kameraet kan, men ikke flere end valgt. Ukendte formater
    (v4l2-ctl kunne ikke spørge): det valgte, så driveren selv vælger det nærmeste."""
    if not formater:
        return (bredde, hoejde), billeder, (bredde, hoejde)
    bred = [s for s in formater if abs(s[0] / s[1] - 16 / 9) < 0.02]
    if (bredde, hoejde) in formater:
        str_, ud = (bredde, hoejde), (bredde, hoejde)
    elif [s for s in bred if s[1] > hoejde]:
        str_, ud = min((s for s in bred if s[1] > hoejde), key=lambda s: s[1]), (bredde, hoejde)
    else:
        under = [s for s in bred if s[1] < hoejde] or [s for s in formater if s[1] < hoejde] or list(formater)
        str_ = max(under, key=lambda s: (s[1], s[0]))
        ud = str_
    rater = formater[str_]
    passer = [r for r in rater if r <= billeder]
    return str_, max(passer) if passer else min(rater), ud


def find_mikrofon(enhed):
    """Kameraets mikrofon: (ALSA-enhed, navn) for lydkortet i samme USB-enhed som
    kameraet, eller (None, None). Aldrig en anden mikrofon (eller TV'ets HDMI-lyd)."""
    usb = os.path.realpath(os.path.join(SYS, 'class/video4linux', os.path.basename(enhed), 'device', '..'))
    for kort in sorted(glob.glob(os.path.join(usb, '*', 'sound', 'card[0-9]*'))):
        nr = os.path.basename(kort)[4:]
        return f'plughw:{nr},0', (laes_tekst(os.path.join(kort, 'id')) or f'kort {nr}')[:100]
    return None, None


def rens_video(v):
    """Serverens video-indstillinger (nye servere) — alt ukendt bliver standard."""
    ud = dict(STANDARD_VIDEO)
    if not isinstance(v, dict):
        return ud
    if (v.get('bredde'), v.get('hoejde')) in OPLOESNINGER:
        ud['bredde'], ud['hoejde'] = v['bredde'], v['hoejde']
    if v.get('billeder') in BILLEDER:
        ud['billeder'] = v['billeder']
    for felt, lovlige in (('kvalitet', KVALITET), ('stoerrelse', STOERRELSE),
                          ('placering', ('top-venstre', 'top-hoejre', 'bund-venstre', 'bund-hoejre'))):
        if v.get(felt) in lovlige:
            ud[felt] = v[felt]
    for felt in ('vend', 'spejl', 'autofokus', 'lyd'):
        ud[felt] = bool(v.get(felt))
    return ud


def bitrate(hoejde, billeder, kvalitet):
    """kbit/s for det, der faktisk sendes (se BITRATE)."""
    trin = min(BITRATE, key=lambda h: abs(h - hoejde))
    return min(int(BITRATE[trin][1 if billeder > 30 else 0] * KVALITET.get(kvalitet, 1.0)), BITRATE_MAX)


# ---------- ffmpeg ----------

def sendeformat(enhed, video, formater, mikrofon):
    """Det, der sendes, ud fra admins valg (video) og det, kameraet kan — som tuple,
    så en ændring (ny opløsning, kameraet vendt …) genstarter ffmpeg."""
    kamera, billeder, ud = vaelg_format(formater, video['bredde'], video['hoejde'], video['billeder'])
    return (('kamera', kamera), ('billeder', billeder), ('ud', ud),
            ('kbit', bitrate(ud[1], billeder, video['kvalitet'])),
            ('vend', video['vend']), ('spejl', video['spejl']), ('autofokus', video['autofokus']),
            ('placering', video['placering']), ('stoerrelse', video['stoerrelse']),
            ('mikrofon', mikrofon))


def ffmpeg_args(enhed, maal, overlay, koder, fmt=None):
    """overlay: None, 'tavle' (scoreboard-billedet) eller 'tekst' (to linjer).
    fmt: sendeformat() — uden: standard (1280x720 @ 30, lydløst)."""
    f = dict(fmt or sendeformat(enhed, STANDARD_VIDEO, {}, None))
    (kb, kh), billeder, (ub, uh), kbit = f['kamera'], f['billeder'], f['ud'], f['kbit']
    args = [FFMPEG, '-hide_banner', '-nostdin', '-loglevel', 'error']
    if koder == 'vaapi':
        args += ['-vaapi_device', RENDER]
    args += ['-f', 'v4l2', '-input_format', 'mjpeg', '-video_size', f'{kb}x{kh}',
             '-framerate', str(billeder), '-thread_queue_size', '512', '-i', enhed]
    if f['mikrofon']:
        args += ['-f', 'alsa', '-thread_queue_size', '1024', '-i', f['mikrofon']]
    else:
        args += ['-f', 'lavfi', '-i', 'anullsrc=channel_layout=stereo:sample_rate=44100']
    # Kameraet: vendt 180° (= vandret + lodret), spejlvendt, skaleret ned
    kamera = []
    if f['vend'] != f['spejl']:
        kamera.append('hflip')
    if f['vend']:
        kamera.append('vflip')
    if (kb, kh) != (ub, uh):
        kamera.append(f'scale={ub}:{uh}')
    nederst = f['placering'].startswith('bund')
    filtre = []
    if overlay == 'tavle':
        # movie-filteret læser billedet igen for hvert halve sekund kamera-
        # billede, så en ny stilling står i billedet efter ca. et sekund.
        # (Som ekstra input med -readrate 1 halter ffmpeg efter kameraet og
        # sender kun få billeder i sekundet.)
        kilde = f'[0:v]{",".join(kamera)}[kam];[kam]' if kamera else '[0:v]'
        filtre.append(f'movie=filename={TAVLE}:f=image2:loop=0:format_opts=framerate=2,'
                      f'setpts=N/2/TB[tavle];{kilde}[tavle]overlay=0:{"main_h-overlay_h" if nederst else 0}')
    else:
        filtre += kamera
        if overlay:
            s = ub / 1280 * STOERRELSE.get(f['stoerrelse'], 1.0)
            kant = round(28 * s)
            x = f'w-tw-{kant}' if f['placering'].endswith('hoejre') else str(kant)
            y = f'h-th-{kant}' if nederst else str(kant)
            filtre.append(f'drawtext=fontfile={SKRIFT}:textfile={OVERLAY}:reload=1:expansion=none'
                          f':fontsize={round(28 * s)}:fontcolor=white:line_spacing={round(8 * s)}'
                          f':box=1:boxcolor=black@0.6:boxborderw={round(14 * s)}:x={x}:y={y}')
    gop = str(billeder * 2)   # nøglebillede hvert 2. sekund (YouTube vil have højst 4)
    rate = [f'-b:v', f'{kbit}k', '-maxrate', f'{kbit}k', '-bufsize', f'{kbit * 2}k']
    if koder == 'vaapi':
        filtre += ['format=nv12', 'hwupload']
        video = ['-c:v', 'h264_vaapi', *rate, '-g', gop, '-bf', '0']
    else:
        filtre.append('format=yuv420p')
        # Over 720p @ 30 er veryfast for tungt for en lille PC's CPU
        preset = 'veryfast' if uh * billeder <= 720 * 30 else 'superfast'
        video = ['-c:v', 'libx264', '-preset', preset, *rate, '-g', gop, '-keyint_min', gop,
                 '-sc_threshold', '0']
    if overlay == 'tavle':
        args += ['-filter_complex', ','.join(filtre) + '[v]', '-map', '[v]']
    else:
        args += ['-vf', ','.join(filtre), '-map', '0:v']
    # Mikrofonens ur går ikke helt i takt med kameraets: aresample retter det
    lyd = ['-af', 'aresample=async=1'] if f['mikrofon'] else []
    args += [*video, *lyd, '-c:a', 'aac', '-b:a', '128k', '-map', '1:a', '-f', 'flv', maal]
    return args


# ---------- Scoreboardet ----------
#
#   ┌ BANE 3 ┐
#   │ ● Hansen / Berg     21  19 │ 11 │
#   │   Jensen / Olsen    15  21 │  8 │
#
# Tegnes i fuld billedbredde (gennemsigtigt udenom), så billedet har samme
# størrelse hver gang — ffmpeg vil ikke have, at det skifter størrelse.
# Målene er til 1280 i bredden med størrelsen "normal" og ganges med
# skala(); placeringen (øverst/nederst, venstre/højre) spejler det hele, og
# logoet står i den modsatte side af samme bånd. ffmpeg lægger båndet øverst
# eller nederst i billedet.

TAVLE_STR = (1280, 220)
PANEL = (12, 16, 24, 235)
STREG = (255, 255, 255, 26)
ACCENT = (233, 69, 96, 255)     # appens accentfarve (#e94560)
FJER = (255, 214, 64, 255)      # hvem der server
HVID = (255, 255, 255, 255)
GRAA = (150, 158, 172, 255)     # det tabte sæt


_skrifter = {}


def skrift(sti, stoerrelse):
    if (sti, stoerrelse) not in _skrifter:
        try:
            _skrifter[(sti, stoerrelse)] = ImageFont.truetype(sti, stoerrelse)
        except OSError:
            _skrifter[(sti, stoerrelse)] = ImageFont.load_default(stoerrelse)
    return _skrifter[(sti, stoerrelse)]


def afkort(d, tekst, f, bredde):
    if d.textlength(tekst, font=f) <= bredde:
        return tekst
    while tekst and d.textlength(tekst + '…', font=f) > bredde:
        tekst = tekst[:-1]
    return tekst.rstrip() + '…'


def skala(bredde, stoerrelse):
    return bredde / 1280 * STOERRELSE.get(stoerrelse, 1.0)


def tavle_str(bredde, stoerrelse):
    return bredde, round(TAVLE_STR[1] * skala(bredde, stoerrelse))


def tegn_tavle_billede(tavle, bredde=1280, stoerrelse='normal', placering='top-venstre', logo=None):
    """Scoreboardet (og logoet) som RGBA-billede (tavle_str); helt gennemsigtigt uden
    kamp og logo. logo: et Pillow-billede eller None."""
    s = skala(bredde, stoerrelse)
    billede = Image.new('RGBA', tavle_str(bredde, stoerrelse), (0, 0, 0, 0))
    hoejre = placering.endswith('hoejre')
    nederst = placering.startswith('bund')
    x0, y0 = round(28 * s), round(26 * s)
    raekke = round(48 * s)
    if logo is not None:
        tegn_logo(billede, logo, s, x0, y0, raekke * 2, hoejre, nederst)
    navne = [str(n or '') for n in (tavle or {}).get('navne') or []][:2]
    if len(navne) < 2:
        return billede
    saet = [k for k in tavle.get('saet') or [] if isinstance(k, list) and len(k) == 2][-5:]
    nu = tavle.get('nu') if isinstance(tavle.get('nu'), list) and len(tavle['nu']) == 2 else None
    serve = tavle.get('serve') if nu else None
    bane = tavle.get('bane')

    d = ImageDraw.Draw(billede)
    f_navn, f_tal, f_nu, f_fane = (skrift(SKRIFT_NAVN, round(25 * s)), skrift(SKRIFT_TAL, round(34 * s)),
                                   skrift(SKRIFT_TAL, round(38 * s)), skrift(SKRIFT_TAL, round(22 * s)))
    fane_h = round(28 * s) if bane else 0
    luft, prik, efter_navn = round(14 * s), round(18 * s), round(14 * s)
    navn_b = int(min(max(max(d.textlength(n, font=f_navn) for n in navne), 150 * s), 520 * s))
    kol, nu_b, nu_luft = round(42 * s), round(62 * s), round(6 * s)
    panel_b = luft + prik + navn_b + efter_navn + kol * len(saet) + (nu_b + nu_luft if nu else luft - nu_luft)
    hoejde = raekke * 2
    # Fanen "BANE 3" står over panelet — nederst i billedet står den stadig over
    # (båndet flyttes, ikke vendes)
    if nederst:
        top = billede.height - y0 - hoejde
        fane_top = top - fane_h
    else:
        fane_top = y0
        top = y0 + fane_h
    venstre = bredde - x0 - panel_b if hoejre else x0

    if bane:
        tekst = f'BANE {bane}'
        fb = int(d.textlength(tekst, font=f_fane)) + round(24 * s)
        fx = venstre + panel_b - fb if hoejre else venstre
        d.rounded_rectangle((fx, fane_top, fx + fb, top + round(8 * s)), radius=round(6 * s), fill=ACCENT,
                            corners=(True, True, False, False))
        d.text((fx + fb / 2, fane_top + fane_h / 2 + 1), tekst, font=f_fane, fill=HVID, anchor='mm')
    # Hjørnet under fanen er skarpt
    d.rounded_rectangle((venstre, top, venstre + panel_b, top + hoejde), radius=round(10 * s), fill=PANEL,
                        corners=(not bane or hoejre, not bane or not hoejre, True, True))
    d.line((venstre + luft, top + raekke, venstre + panel_b - (nu_b + nu_luft if nu else luft), top + raekke),
           fill=STREG, width=1)

    r_prik = round(5 * s)
    for i in (0, 1):
        midt = top + raekke * i + raekke / 2
        if serve == i + 1:
            d.ellipse((venstre + luft, midt - r_prik, venstre + luft + 2 * r_prik, midt + r_prik), fill=FJER)
        x = venstre + luft + prik
        d.text((x, midt), afkort(d, navne[i], f_navn, navn_b), font=f_navn, fill=HVID, anchor='lm')
        x += navn_b + efter_navn
        for k in saet:
            vundet = k[i] > k[1 - i]
            d.text((x + kol / 2, midt + 2), str(k[i]), font=f_tal,
                   fill=HVID if vundet else GRAA, anchor='mm')
            x += kol
    if nu:
        x = venstre + panel_b - nu_b - nu_luft
        d.rounded_rectangle((x, top + nu_luft, x + nu_b, top + hoejde - nu_luft), radius=round(8 * s), fill=ACCENT)
        d.line((x + round(8 * s), top + raekke, x + nu_b - round(8 * s), top + raekke),
               fill=(255, 255, 255, 60), width=1)
        for i in (0, 1):
            d.text((x + nu_b / 2, top + raekke * i + raekke / 2 + 2), str(nu[i]), font=f_nu,
                   fill=HVID, anchor='mm')
    return billede


def tegn_logo(billede, logo, s, x0, y0, hoejde, hoejre, nederst):
    """Logoet i den modsatte side af scoreboardet: højst så højt som scoreboardets
    to rækker og en fjerdedel af billedbredden. Gennemsigtighed bevares."""
    max_b, max_h = int(billede.width * 0.25), hoejde
    faktor = min(max_b / logo.width, max_h / logo.height)
    lb, lh = max(1, round(logo.width * faktor)), max(1, round(logo.height * faktor))
    lille = logo.resize((lb, lh), getattr(Image, 'Resampling', Image).LANCZOS)
    x = x0 if hoejre else billede.width - x0 - lb
    y = billede.height - y0 - lh if nederst else y0
    billede.alpha_composite(lille, (x, y))


