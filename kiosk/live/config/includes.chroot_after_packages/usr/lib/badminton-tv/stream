def log(tekst):
    print(f'[stream] {tekst}', flush=True)


def laes_tekst(sti):
    try:
        with open(sti, encoding='utf-8', errors='replace') as f:
            return f.read().strip()
    except OSError:
        return ''


# Samme som rapport: (TV_URL, NAVN) fra setup's kiosk.env og (server, token)
def kiosk_env():
    try:
        ud = subprocess.run(
            ['bash', '-c', 'set -a; . "$1" 2>/dev/null; printf "%s\\0%s" "${BT_TV_URL:-}" "${BT_NAVN:-}"',
             'bash', KIOSK_ENV], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        ud = ''
    url, _, navn = ud.partition('\0')
    return url.strip(), navn.strip()


def adgangslink(tv_url):
    try:
        u = urllib.parse.urlsplit(tv_url)
    except ValueError:
        return None, None
    m = re.match(r'^/t/([A-Za-z0-9_-]{8,128})/?$', u.path or '')
    if u.scheme not in ('http', 'https') or not u.netloc or not m:
        return None, None
    return f'{u.scheme}://{u.netloc}', m.group(1)


# ---------- Kameraet ----------

def kamera_navn(sti, enhed):
    """Kameraets navn fra kernen — ellers af by-id-linket."""
    navn = laes_tekst(os.path.join(SYS, 'class/video4linux', os.path.basename(enhed), 'name'))
    if not navn:
        # by-id-navnet: usb-046d_HD_Pro_Webcam_C920_1234-video-index0 — nyere udev
        # laver også et link med interface-nummer: …_1234-if00-video-index0
        navn = re.sub(r'^usb-[0-9a-f]{4}_|_[0-9A-F]{6,}(-if\d+)?-video-index0$|(-if\d+)?-video-index0$', '',
                      os.path.basename(sti)).replace('_', ' ')
    return navn[:100]


# Det infrarøde kamera til Windows Hello (og dybdekameraer) står i navnet på
# enheden, USB-interfacet eller by-id-linket: "Integrated IR Camera", "…_IR_Camera…"
IR_NAVN = re.compile(r'(^|[^a-z0-9])(ir|infra ?red|infrarød|hello|depth)([^a-z0-9]|$)', re.I)
# Under denne størrelse er et kamera med farveformat sandsynligvis det infrarøde
# (Windows Hello-kameraer tilbyder ofte YUYV i 340x340, 640x360 eller 640x400) —
# det vælges kun, hvis intet andet kamera kan noget
STORT = 1280 * 720


def er_infraroed(sti, enhed):
    """Navnet på enheden, USB-interfacet eller linket siger infrarødt/Hello/dybde."""
    v4l = os.path.join(SYS, 'class/video4linux', os.path.basename(enhed))
    navne = [laes_tekst(os.path.join(v4l, 'name')), laes_tekst(os.path.join(v4l, 'device/interface')),
             os.path.basename(sti)]
    return any(n and IR_NAVN.search(n.replace('_', ' ').replace('-', ' ')) for n in navne)


_fravalgt = set()   # (enhed, grund) — hvert fravalg logges én gang


def kamera_links():
    """[(by-id-link, enhed)] — hvert kamera én gang, med det første link i sorteret
    rækkefølge: linket med interface-nummer (…-if00-video-index0) før det uden."""
    kandidater, set_ = [], set()
    for sti in sorted(glob.glob(KAMERA_GLOB)):
        enhed = os.path.realpath(sti)
        if enhed not in set_:
            set_.add(enhed)
            kandidater.append((sti, enhed))
    return kandidater


def interface_nr(sti):
    """USB-interfacet fra by-id-linket ('00' for …-if00-video-index0), ellers None."""
    m = re.search(r'-if(\d+)-video-index\d+$', os.path.basename(sti or ''))
    return m.group(1) if m else None


def find_kamera(undersoeg=None, proev=None, valgt=None):
    """(enhed, navn) for det USB-kamera, der skal sende billedet — eller (None, None).
    Ét kamera kan vise sig som flere videoenheder: Windows Hello-kameraer (Lenovo 500
    FHD, Brio 4K …) har et infrarødt kamera ved siden af billedet — ofte med SAMME
    navn (kernen klipper det ved 31 tegn) og måske samme formatliste — og udev laver
    både et link med interface-nummer (-if00-) og et uden.

    valgt: by-id-linket, admin har valgt for PC'en — det bruges, når det findes.
    Ellers aldrig det infrarøde: enheder med IR/Infrared/Hello/Depth i navnet og
    enheder, der kun har gråtoner (GREY, Y8, Y16 …), springes over. Er der derefter
    flere, optages et prøvebillede fra hver (proev): et infrarødt billede har ingen
    farver, og en enhed med farver vinder altid over en grå. Så vinder:
      1. et farvekamera i mindst 1280x720 — MJPEG før YUYV, så den største opløsning
      2. en enhed, v4l2-ctl ikke svarede for (fx endnu ikke klar ved opstart) —
         den spørges igen hver gang, og svarer den med et godt format, skiftes der
      3. et farvekamera under 1280x720 (et billigt kamera — eller et IR-kamera,
         der også kan YUYV; det tages kun, når der ikke er andet)
      4. ved lige: det laveste USB-interface (billedet er typisk if00, IR'en if02)
    undersoeg: enhed -> kamera_undersoeg(); proev: (enhed, formater) -> 'farve',
    'graa' eller None (kunne ikke optage). Sender giver sine caches med."""
    undersoeg = undersoeg or kamera_undersoeg
    kandidater = kamera_links()
    if not kandidater:
        return None, None

    if valgt:
        for sti in sorted(glob.glob(KAMERA_GLOB)):
            if os.path.basename(sti) == valgt:
                enhed = os.path.realpath(sti)
                if (enhed, 'valgt') not in _fravalgt:
                    _fravalgt.add((enhed, 'valgt'))
                    log(f'{enhed}: valgt i admin ({valgt})')
                return enhed, kamera_navn(sti, enhed)
        if (valgt, 'mangler') not in _fravalgt:
            _fravalgt.add((valgt, 'mangler'))
            log(f'kameraet valgt i admin ({valgt}) findes ikke — vælger selv')

    def fravalg(enhed, grund):
        if (enhed, grund) not in _fravalgt:
            _fravalgt.add((enhed, grund))
            log(f'{enhed}: springes over — {grund}')

    # Et infrarødt link til en enhed gælder enheden (Brio: et link med og et uden interface)
    ir = {enhed for sti, enhed in kandidater if er_infraroed(sti, enhed)}
    rest = []
    for nr, (sti, enhed) in enumerate(kandidater):
        if enhed in ir:
            fravalg(enhed, 'infrarødt kamera (Windows Hello/dybde) efter navnet')
            continue
        formater, navne = undersoeg(enhed)
        farve = [n for n in INPUT_ORDEN if formater.get(n)]
        if navne and not navne & INPUTFORMATER.keys():
            fravalg(enhed, f'kun {", ".join(sorted(navne))} — gråtoner (infrarødt kamera) eller '
                           f'formater, vi ikke kan sende')
            continue
        if farve:
            pixels = max(b * h for n in farve for (b, h) in formater[n])
            noegle = (2 if pixels >= STORT else 0, 'mjpeg' in farve, pixels, -nr)
        else:
            noegle = (1, False, 0, -nr)
        rest.append((noegle, sti, enhed, formater))
    if not rest:
        return None, None
    # Flere tilbage: prøvebilledet skiller billedet fra det infrarøde kamera, også
    # når de hedder det samme og har samme formater. Et kamera, der ikke kunne
    # optage (None — fx i brug), tælles ikke som gråt
    if len(rest) > 1 and proev:
        rest = [((proev(enhed, formater) != 'graa',) + noegle, sti, enhed, formater)
                for noegle, sti, enhed, formater in rest]
    _, sti, enhed, _ = max(rest, key=lambda r: r[0])
    return enhed, kamera_navn(sti, enhed)


def stil_kamera(enhed, autofokus=False):
    """50 Hz og fast fokus (eller autofokus) — kameraer, der ikke har indstillingen, springer den over."""
    fokus = (('focus_automatic_continuous=1', 'focus_auto=1') if autofokus else
             ('focus_automatic_continuous=0', 'focus_auto=0', 'focus_absolute=0'))
    for ctrl in ('power_line_frequency=1', *fokus):
        try:
            subprocess.run([V4L2CTL, '-d', enhed, '-c', ctrl], capture_output=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            pass


# Kameraets billedformat (v4l2-ctl) → ffmpegs -input_format, i den rækkefølge de
# foretrækkes: MJPEG er komprimeret, så 1080p @ 30 kan nå gennem USB 2 (nogle
# kameraer kalder det JPEG); billige kameraer uden MJPEG sender råt YUYV
INPUTFORMATER = {'MJPG': 'mjpeg', 'JPEG': 'mjpeg', 'YUYV': 'yuyv422'}
INPUT_ORDEN = ('mjpeg', 'yuyv422')
INPUT_NAVN = {'mjpeg': 'MJPEG', 'yuyv422': 'YUYV'}
RAA_MIN_BILLEDER = 20   # råt billede: hellere en lavere opløsning end 5–10 billeder i sekundet


def kamera_formater(enhed):
    """Kameraets formater pr. inputformat: {'mjpeg': {(bredde, hoejde): [billeder
    i sekundet, …]}, 'yuyv422': …} — {} når v4l2-ctl ikke kunne spørge."""
    return kamera_undersoeg(enhed)[0]


def kamera_undersoeg(enhed):
    """(formater, formatnavne): kamera_formater() — og alle de formater, v4l2-ctl
    nævnte (fx {'GREY'} for et infrarødt kamera; tom: kameraet svarede ikke, fx
    fordi det endnu ikke var klar ved opstart)."""
    try:
        ud = subprocess.run([V4L2CTL, '-d', enhed, '--list-formats-ext'],
                            capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return {}, set()
    alle, formater, str_ = {}, None, None
    navne = set()
    for linje in ud.splitlines():
        m = re.search(r"\[\d+\]: '(\w+)'", linje)
        if m:
            navne.add(m.group(1))
            navn = INPUTFORMATER.get(m.group(1))
            formater, str_ = alle.setdefault(navn, {}) if navn else None, None
            continue
        if formater is None:
            continue
        m = re.search(r'Size: Discrete (\d+)x(\d+)', linje)
        if m:
            str_ = (int(m.group(1)), int(m.group(2)))
            formater.setdefault(str_, set())
            continue
        m = re.search(r'\(([\d.]+) fps\)', linje)
        if m and str_:
            formater[str_].add(round(float(m.group(1))))
    alle = {n: {s: sorted(r) for s, r in f.items() if r} for n, f in alle.items()}
    return {n: f for n, f in alle.items() if f}, navne


# Prøvebilledet: farvemætningen (gennemsnitlig afstand fra gråt i U og V, 0–128).
# Et infrarødt billede er gråt (U = V = 128, højst lidt støj fra komprimeringen);
# en hal i farver — også en mørk — ligger langt over
GRAA_KROMA = 2.0
PROEVE_STR = (64, 36)       # billedet skaleres ned: kun farverne tæller
PROEVE_BILLEDER = 8         # de første springes over (eksponering, IR-lyset tænder)


def proev_billede(enhed, formater):
    """('farve' | 'graa' | None, kroma): optag et par billeder fra enheden og mål
    farvemætningen. None: kunne ikke optage (i brug, ikke klar …)."""
    input_, f = vaelg_input(formater)
    args = [FFMPEG, '-hide_banner', '-loglevel', 'error', '-f', 'v4l2', '-input_format', input_]
    if f:
        # Den mindste størrelse, kameraet har i formatet — hurtigst
        (b, h), _ = min(f.items(), key=lambda x: x[0][0] * x[0][1])
        args += ['-video_size', f'{b}x{h}']
    args += ['-i', enhed, '-frames:v', str(PROEVE_BILLEDER),
             '-vf', f'scale={PROEVE_STR[0]}:{PROEVE_STR[1]},format=yuv444p', '-f', 'rawvideo', '-']
    try:
        ud = subprocess.run(args, capture_output=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None, None
    flade = PROEVE_STR[0] * PROEVE_STR[1]
    billeder = [ud[i:i + 3 * flade] for i in range(0, len(ud) - 3 * flade + 1, 3 * flade)]
    if len(billeder) < 2:
        return None, None
    # Det mest farverige af de sidste billeder: Hello-kameraer tænder IR-lyset hvert
    # andet billede, men grå er de alle; et farvekamera har farver i dem alle
    kroma = max(sum(abs(x - 128) for x in b[flade:]) / (2 * flade) for b in billeder[len(billeder) // 2:])
    return ('farve' if kroma >= GRAA_KROMA else 'graa'), round(kroma, 1)


def vaelg_input(alle, afvist=()):
    """(inputformat, formater): det første i INPUT_ORDEN, kameraet har — og som
    ffmpeg ikke allerede har fået afvist (afvist). Kender vi ikke kameraets formater,
    prøves de i rækkefølge; er alle afvist, det første (så fejlen vises i admin)."""
    kandidater = [n for n in INPUT_ORDEN if alle.get(n)] + [n for n in INPUT_ORDEN if not alle.get(n)]
    navn = next((n for n in kandidater if n not in afvist), kandidater[0])
    return navn, alle.get(navn, {})


def vaelg_format(formater, bredde, hoejde, billeder, raa=False):
    """((kamera-bredde, -højde), billeder, (sendt bredde, højde)): det valgte, eller det
    bedste, kameraet kan. Har kameraet ikke opløsningen, men en større i 16:9, skaleres
    den ned; ellers tages den største derunder. Opløsningen går forud for billederne:
    1080p med 60 valgt, kameraet kan 1080p med 30 og 720p med 60 → 1080p med 30.
    Billeder: de flest, kameraet kan, men ikke flere end valgt. Råt billede (raa):
    kun opløsninger med mindst RAA_MIN_BILLEDER, hvis kameraet har nogen. Ukendte
    formater (v4l2-ctl kunne ikke spørge): det valgte, så driveren selv vælger det nærmeste."""
    if raa:
        formater = {s: r for s, r in formater.items() if max(r) >= RAA_MIN_BILLEDER} or formater
    if not formater:
        return (bredde, hoejde), billeder, (bredde, hoejde)
    bred = [s for s in formater if abs(s[0] / s[1] - 16 / 9) < 0.02]
    if (bredde, hoejde) in formater:
        str_, ud = (bredde, hoejde), (bredde, hoejde)
    elif [s for s in bred if s[1] > hoejde]:
        str_, ud = min((s for s in bred if s[1] > hoejde), key=lambda s: s[1]), (bredde, hoejde)
    else:
        under = [s for s in bred if s[1] < hoejde] or [s for s in formater if s[1] < hoejde] or list(formater)
        str_ = max(under, key=lambda s: (s[1], s[0]))
        ud = str_
    rater = formater[str_]
    passer = [r for r in rater if r <= billeder]
    return str_, max(passer) if passer else min(rater), ud


def find_mikrofon(enhed):
    """Kameraets mikrofon: (ALSA-enhed, navn) for lydkortet i samme USB-enhed som
    kameraet, eller (None, None). Aldrig en anden mikrofon (eller TV'ets HDMI-lyd)."""
    usb = os.path.realpath(os.path.join(SYS, 'class/video4linux', os.path.basename(enhed), 'device', '..'))
    for kort in sorted(glob.glob(os.path.join(usb, '*', 'sound', 'card[0-9]*'))):
        nr = os.path.basename(kort)[4:]
        return f'plughw:{nr},0', (laes_tekst(os.path.join(kort, 'id')) or f'kort {nr}')[:100]
    return None, None


def rens_video(v):
    """Serverens video-indstillinger (nye servere) — alt ukendt bliver standard."""
    ud = dict(STANDARD_VIDEO)
    if not isinstance(v, dict):
        return ud
    if (v.get('bredde'), v.get('hoejde')) in OPLOESNINGER:
        ud['bredde'], ud['hoejde'] = v['bredde'], v['hoejde']
    if v.get('billeder') in BILLEDER:
        ud['billeder'] = v['billeder']
    for felt, lovlige in (('kvalitet', KVALITET), ('stoerrelse', STOERRELSE),
                          ('placering', ('top-venstre', 'top-hoejre', 'bund-venstre', 'bund-hoejre'))):
        if v.get(felt) in lovlige:
            ud[felt] = v[felt]
    for felt in ('vend', 'spejl', 'autofokus', 'lyd'):
        ud[felt] = bool(v.get(felt))
    return ud


def bitrate(hoejde, billeder, kvalitet):
    """kbit/s for det, der faktisk sendes (se BITRATE)."""
    trin = min(BITRATE, key=lambda h: abs(h - hoejde))
    return min(int(BITRATE[trin][1 if billeder > 30 else 0] * KVALITET.get(kvalitet, 1.0)), BITRATE_MAX)


# ---------- ffmpeg ----------

def sendeformat(enhed, video, formater, mikrofon, input_='mjpeg'):
    """Det, der sendes, ud fra admins valg (video) og det, kameraet kan i inputformatet
    input_ — som tuple, så en ændring (ny opløsning, kameraet vendt …) genstarter ffmpeg."""
    kamera, billeder, ud = vaelg_format(formater, video['bredde'], video['hoejde'], video['billeder'],
                                        raa=input_ != 'mjpeg')
    return (('input', input_), ('kamera', kamera), ('billeder', billeder), ('ud', ud),
            ('kbit', bitrate(ud[1], billeder, video['kvalitet'])),
            ('vend', video['vend']), ('spejl', video['spejl']), ('autofokus', video['autofokus']),
            ('placering', video['placering']), ('stoerrelse', video['stoerrelse']),
            ('mikrofon', mikrofon))


def ffmpeg_args(enhed, maal, overlay, koder, fmt=None):
    """overlay: None, 'tavle' (scoreboard-billedet) eller 'tekst' (to linjer).
    fmt: sendeformat() — uden: standard (1280x720 @ 30, lydløst)."""
    f = dict(fmt or sendeformat(enhed, STANDARD_VIDEO, {}, None))
    (kb, kh), billeder, (ub, uh), kbit = f['kamera'], f['billeder'], f['ud'], f['kbit']
    args = [FFMPEG, '-hide_banner', '-nostdin', '-loglevel', 'error']
    if koder == 'vaapi':
        args += ['-vaapi_device', RENDER]
    args += ['-f', 'v4l2', '-input_format', f['input'], '-video_size', f'{kb}x{kh}',
             '-framerate', str(billeder), '-thread_queue_size', '512', '-i', enhed]
    if f['mikrofon']:
        args += ['-f', 'alsa', '-thread_queue_size', '1024', '-i', f['mikrofon']]
    else:
        args += ['-f', 'lavfi', '-i', 'anullsrc=channel_layout=stereo:sample_rate=44100']
    # Kameraet: vendt 180° (= vandret + lodret), spejlvendt, skaleret ned
    kamera = []
    if f['vend'] != f['spejl']:
        kamera.append('hflip')
    if f['vend']:
        kamera.append('vflip')
    if (kb, kh) != (ub, uh):
        kamera.append(f'scale={ub}:{uh}')
    nederst = f['placering'].startswith('bund')
    filtre = []
    if overlay == 'tavle':
        # movie-filteret læser billedet igen for hvert halve sekund kamera-
        # billede, så en ny stilling står i billedet efter ca. et sekund.
        # (Som ekstra input med -readrate 1 halter ffmpeg efter kameraet og
        # sender kun få billeder i sekundet.)
        kilde = f'[0:v]{",".join(kamera)}[kam];[kam]' if kamera else '[0:v]'
        filtre.append(f'movie=filename={TAVLE}:f=image2:loop=0:format_opts=framerate=2,'
                      f'setpts=N/2/TB[tavle];{kilde}[tavle]overlay=0:{"main_h-overlay_h" if nederst else 0}')
    else:
        filtre += kamera
        if overlay:
            s = ub / 1280 * STOERRELSE.get(f['stoerrelse'], 1.0)
            kant = round(28 * s)
            x = f'w-tw-{kant}' if f['placering'].endswith('hoejre') else str(kant)
            y = f'h-th-{kant}' if nederst else str(kant)
            filtre.append(f'drawtext=fontfile={SKRIFT}:textfile={OVERLAY}:reload=1:expansion=none'
                          f':fontsize={round(28 * s)}:fontcolor=white:line_spacing={round(8 * s)}'
                          f':box=1:boxcolor=black@0.6:boxborderw={round(14 * s)}:x={x}:y={y}')
    gop = str(billeder * 2)   # nøglebillede hvert 2. sekund (YouTube vil have højst 4)
    rate = [f'-b:v', f'{kbit}k', '-maxrate', f'{kbit}k', '-bufsize', f'{kbit * 2}k']
    if koder == 'vaapi':
        filtre += ['format=nv12', 'hwupload']
        video = ['-c:v', 'h264_vaapi', *rate, '-g', gop, '-bf', '0']
    else:
        filtre.append('format=yuv420p')
        # Over 720p @ 30 er veryfast for tungt for en lille PC's CPU
        preset = 'veryfast' if uh * billeder <= 720 * 30 else 'superfast'
        video = ['-c:v', 'libx264', '-preset', preset, *rate, '-g', gop, '-keyint_min', gop,
                 '-sc_threshold', '0']
    if overlay == 'tavle':
        args += ['-filter_complex', ','.join(filtre) + '[v]', '-map', '[v]']
    else:
        args += ['-vf', ','.join(filtre), '-map', '0:v']
    # Mikrofonens ur går ikke helt i takt med kameraets: aresample retter det
    lyd = ['-af', 'aresample=async=1'] if f['mikrofon'] else []
    args += [*video, *lyd, '-c:a', 'aac', '-b:a', '128k', '-map', '1:a', '-f', 'flv', maal]
    return args


# ---------- Scoreboardet ----------
#
#   ┌ BANE 3 ┐
#   │ ● Hansen / Berg     21  19 │ 11 │
#   │   Jensen / Olsen    15  21 │  8 │
#
# Tegnes i fuld billedbredde (gennemsigtigt udenom), så billedet har samme
# størrelse hver gang — ffmpeg vil ikke have, at det skifter størrelse.
# Målene er til 1280 i bredden med størrelsen "normal" og ganges med
# skala(); placeringen (øverst/nederst, venstre/højre) spejler det hele, og
# logoet står i den modsatte side af samme bånd. ffmpeg lægger båndet øverst
# eller nederst i billedet.

TAVLE_STR = (1280, 220)
PANEL = (12, 16, 24, 235)
STREG = (255, 255, 255, 26)
ACCENT = (233, 69, 96, 255)     # appens accentfarve (#e94560)
FJER = (255, 214, 64, 255)      # hvem der server
HVID = (255, 255, 255, 255)
GRAA = (150, 158, 172, 255)     # det tabte sæt


_skrifter = {}


def skrift(sti, stoerrelse):
    if (sti, stoerrelse) not in _skrifter:
        try:
            _skrifter[(sti, stoerrelse)] = ImageFont.truetype(sti, stoerrelse)
        except OSError:
            _skrifter[(sti, stoerrelse)] = ImageFont.load_default(stoerrelse)
    return _skrifter[(sti, stoerrelse)]


def afkort(d, tekst, f, bredde):
    if d.textlength(tekst, font=f) <= bredde:
        return tekst
    while tekst and d.textlength(tekst + '…', font=f) > bredde:
        tekst = tekst[:-1]
    return tekst.rstrip() + '…'


def skala(bredde, stoerrelse):
    return bredde / 1280 * STOERRELSE.get(stoerrelse, 1.0)


def tavle_str(bredde, stoerrelse):
    return bredde, round(TAVLE_STR[1] * skala(bredde, stoerrelse))


def tegn_tavle_billede(tavle, bredde=1280, stoerrelse='normal', placering='top-venstre', logo=None,
                       navn_logoer=(None, None)):
    """Scoreboardet (og logoet) som RGBA-billede (tavle_str); helt gennemsigtigt uden
    kamp og logo. logo: et Pillow-billede eller None. navn_logoer: klublogoerne
    ud for de to rækkers navne (Pillow-billeder eller None), som på TV'et."""
    s = skala(bredde, stoerrelse)
    billede = Image.new('RGBA', tavle_str(bredde, stoerrelse), (0, 0, 0, 0))
    hoejre = placering.endswith('hoejre')
    nederst = placering.startswith('bund')
    x0, y0 = round(28 * s), round(26 * s)
    raekke = round(48 * s)
    if logo is not None:
        tegn_logo(billede, logo, s, x0, y0, raekke * 2, hoejre, nederst)
    navne = [str(n or '') for n in (tavle or {}).get('navne') or []][:2]
    if len(navne) < 2:
        return billede
    saet = [k for k in tavle.get('saet') or [] if isinstance(k, list) and len(k) == 2][-5:]
    nu = tavle.get('nu') if isinstance(tavle.get('nu'), list) and len(tavle['nu']) == 2 else None
    serve = tavle.get('serve') if nu else None
    bane = tavle.get('bane')

    d = ImageDraw.Draw(billede)
    f_navn, f_tal, f_nu, f_fane = (skrift(SKRIFT_NAVN, round(25 * s)), skrift(SKRIFT_TAL, round(34 * s)),
                                   skrift(SKRIFT_TAL, round(38 * s)), skrift(SKRIFT_TAL, round(22 * s)))
    fane_h = round(28 * s) if bane else 0
    luft, prik, efter_navn = round(14 * s), round(18 * s), round(14 * s)
    # +1: textlength er et kommatal — rundet ned blev det længste navn afkortet
    navn_b = int(min(max(max(d.textlength(n, font=f_navn) for n in navne), 150 * s), 520 * s)) + 1
    kol, nu_b, nu_luft = round(42 * s), round(62 * s), round(6 * s)
    # Klublogoerne står i en kolonne foran navnene — kun når mindst én række har et
    logo_b = round(38 * s) + round(8 * s) if any(l is not None for l in navn_logoer) else 0
    panel_b = luft + prik + logo_b + navn_b + efter_navn + kol * len(saet) + (nu_b + nu_luft if nu else luft - nu_luft)
    hoejde = raekke * 2
    # Fanen "BANE 3" står over panelet — nederst i billedet står den stadig over
    # (båndet flyttes, ikke vendes)
    if nederst:
        top = billede.height - y0 - hoejde
        fane_top = top - fane_h
    else:
        fane_top = y0
        top = y0 + fane_h
    venstre = bredde - x0 - panel_b if hoejre else x0

    if bane:
        tekst = f'BANE {bane}'
        fb = int(d.textlength(tekst, font=f_fane)) + round(24 * s)
        fx = venstre + panel_b - fb if hoejre else venstre
        d.rounded_rectangle((fx, fane_top, fx + fb, top + round(8 * s)), radius=round(6 * s), fill=ACCENT,
                            corners=(True, True, False, False))
        d.text((fx + fb / 2, fane_top + fane_h / 2 + 1), tekst, font=f_fane, fill=HVID, anchor='mm')
    # Hjørnet under fanen er skarpt
    d.rounded_rectangle((venstre, top, venstre + panel_b, top + hoejde), radius=round(10 * s), fill=PANEL,
                        corners=(not bane or hoejre, not bane or not hoejre, True, True))
    d.line((venstre + luft, top + raekke, venstre + panel_b - (nu_b + nu_luft if nu else luft), top + raekke),
           fill=STREG, width=1)

    r_prik = round(5 * s)
    for i in (0, 1):
        midt = top + raekke * i + raekke / 2
        if serve == i + 1:
            d.ellipse((venstre + luft, midt - r_prik, venstre + luft + 2 * r_prik, midt + r_prik), fill=FJER)
        x = venstre + luft + prik
        if navn_logoer[i] is not None:
            tegn_i_felt(billede, navn_logoer[i], x, midt, round(38 * s), round(34 * s))
        x += logo_b
        d.text((x, midt), afkort(d, navne[i], f_navn, navn_b), font=f_navn, fill=HVID, anchor='lm')
        x += navn_b + efter_navn
        for k in saet:
            vundet = k[i] > k[1 - i]
            d.text((x + kol / 2, midt + 2), str(k[i]), font=f_tal,
                   fill=HVID if vundet else GRAA, anchor='mm')
            x += kol
    if nu:
        x = venstre + panel_b - nu_b - nu_luft
        d.rounded_rectangle((x, top + nu_luft, x + nu_b, top + hoejde - nu_luft), radius=round(8 * s), fill=ACCENT)
        d.line((x + round(8 * s), top + raekke, x + nu_b - round(8 * s), top + raekke),
               fill=(255, 255, 255, 60), width=1)
        for i in (0, 1):
            d.text((x + nu_b / 2, top + raekke * i + raekke / 2 + 2), str(nu[i]), font=f_nu,
                   fill=HVID, anchor='mm')
    return billede


def tegn_i_felt(billede, logo, x, midt, max_b, max_h):
    """Et klublogo så stort som muligt inden for max_b x max_h, centreret i feltet,
    der starter ved x og har midten i højden midt."""
    faktor = min(max_b / logo.width, max_h / logo.height)
    lb, lh = max(1, round(logo.width * faktor)), max(1, round(logo.height * faktor))
    lille = logo.resize((lb, lh), getattr(Image, 'Resampling', Image).LANCZOS)
    billede.alpha_composite(lille, (round(x + (max_b - lb) / 2), round(midt - lh / 2)))


def tegn_logo(billede, logo, s, x0, y0, hoejde, hoejre, nederst):
    """Logoet i den modsatte side af scoreboardet: højst så højt som scoreboardets
    to rækker og en fjerdedel af billedbredden. Gennemsigtighed bevares."""
    max_b, max_h = int(billede.width * 0.25), hoejde
    faktor = min(max_b / logo.width, max_h / logo.height)
    lb, lh = max(1, round(logo.width * faktor)), max(1, round(logo.height * faktor))
    lille = logo.resize((lb, lh), getattr(Image, 'Resampling', Image).LANCZOS)
    x = x0 if hoejre else billede.width - x0 - lb
    y = billede.height - y0 - lh if nederst else y0
    billede.alpha_composite(lille, (x, y))


_sidste_tavle = object()


def skriv_tavle(tavle, video=STANDARD_VIDEO, bredde=1280, logo=None, logo_sti=None, navn_logoer=(None, None)):
    """Kun når noget har ændret sig — tegningen tager lidt CPU. bredde: den sendte
    billedbredde; logo_sti: logoets adresse (genkender et logo, der er tegnet før);
    navn_logoer: klublogoerne ud for navnene (adresserne står i tavle['logoer'])."""
    global _sidste_tavle
    noegle = (json.dumps(tavle, sort_keys=True), bredde, video['stoerrelse'], video['placering'],
              logo_sti if logo is not None else None, tuple(l is not None for l in navn_logoer))
    if noegle == _sidste_tavle and os.path.exists(TAVLE):
        return
    os.makedirs(MAPPE, exist_ok=True)
    ny = TAVLE + '.ny.png'
    tegn_tavle_billede(tavle, bredde, video['stoerrelse'], video['placering'], logo, navn_logoer).save(ny)
    os.replace(ny, TAVLE)
    _sidste_tavle = noegle


