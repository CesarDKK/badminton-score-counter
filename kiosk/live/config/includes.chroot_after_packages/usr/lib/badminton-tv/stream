LOGO_MAX_BYTES = 5 * 1024 * 1024
LOGO_IGEN = _tal('BT_LOGO_IGEN', 60)   # et logo, der ikke kunne hentes, prøves igen efter så længe
_logoer = collections.OrderedDict()    # adresse -> Pillow-billede (de seneste få: sponsorer skifter)
_logo_fejl = {}                        # adresse -> tidspunkt for seneste fejl


def hent_logo(server, sti):
    """Logoet fra serverens /uploads/… som RGBA-billede, eller None. Hentes én gang."""
    if Image is None or not isinstance(sti, str) or '..' in sti or \
            not re.match(r'^/uploads/[A-Za-z0-9_./-]+\.(png|jpe?g|webp|gif)$', sti, re.I):
        return None
    if sti in _logoer:
        _logoer.move_to_end(sti)
        return _logoer[sti]
    if time.monotonic() - _logo_fejl.get(sti, -LOGO_IGEN) < LOGO_IGEN:
        return None
    try:
        req = urllib.request.Request(server + sti, headers={'User-Agent': 'badminton-tv-stream'})
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            data = r.read(LOGO_MAX_BYTES + 1)
        if len(data) > LOGO_MAX_BYTES:
            raise ValueError('for stort')
        billede = Image.open(io.BytesIO(data))
        billede.thumbnail((1920, 1080))
        billede = billede.convert('RGBA')
    except (urllib.error.URLError, OSError, ValueError) as e:
        log(f'logoet kunne ikke hentes ({sti}): {getattr(e, "reason", e)}')
        _logo_fejl[sti] = time.monotonic()
        return None
    _logoer[sti] = billede
    while len(_logoer) > 8:
        _logoer.popitem(last=False)
    return billede


def forklar(linjer, str_='1280x720'):
    """ffmpegs fejl i ord, admin kan bruge. str_: den opløsning, kameraet blev bedt om."""
    alt = '\n'.join(linjer)
    if MIKROFON_FEJL.search(alt):
        return 'Kameraets mikrofon kunne ikke bruges — sender uden lyd'
    if re.search(r'Device or resource busy', alt):
        return 'Kameraet er optaget af et andet program'
    if re.search(r'No such file or directory|No such device', alt) and '/dev/video' in alt:
        return 'Kameraet forsvandt — sidder USB-kablet ordentligt?'
    if re.search(r'Connection refused|Connection reset|Broken pipe|Input/output error|'
                 r'Server returned 4|Server error|Error in the pull function|handshake', alt, re.I):
        return 'YouTube afviste forbindelsen — tjek stream-nøglen, og at kanalen må sende live'
    if re.search(r'Network is unreachable|Name or service not known|Temporary failure in name resolution|'
                 r'timed out', alt, re.I):
        return 'Ingen forbindelse til YouTube — nettet i hallen?'
    if re.search(r'Cannot open|not supported|Invalid argument', alt) and 'mjpeg' in alt.lower():
        return f'Kameraet kan ikke sende MJPEG {str_} — vælg en lavere opløsning, eller prøv et andet kamera'
    return (linjer[-1] if linjer else 'ffmpeg stoppede uden besked')[:200]


MIKROFON_FEJL = re.compile(r'\balsa\b|plughw:|cannot open audio device|ALSA', re.I)


class Stream:
    def __init__(self):
        self.proc = None
        self.noegle = ''
        self.opsaetning = None      # (enhed, maal, overlay, format) for den kørende
        self.fmt = None             # sendeformat() for den kørende
        self.startet = 0
        self.fejl = None
        self.forsoeg = 0
        self.naeste = 0             # tidligst næste start efter en fejl
        self.koder = 'vaapi' if os.path.exists(RENDER) else 'x264'
        self.uden_mikrofon = set()  # kameraer, hvis mikrofon ikke kunne bruges
        self.formater = {}          # enhed -> kamera_formater() (spørges én gang)
        self.linjer = collections.deque(maxlen=20)

    def format_tekst(self):
        """Til admin: det, der faktisk sendes, fx '1280x720@30' (None: sender ikke)."""
        if not self.koerer() or not self.fmt:
            return None
        f = dict(self.fmt)
        return f'{f["ud"][0]}x{f["ud"][1]}@{f["billeder"]}'

    def mikrofon_navn(self):
        return dict(self.fmt).get('mikrofon_navn') if self.koerer() and self.fmt else None

    def koerer(self):
        return self.proc is not None and self.proc.poll() is None

    def _laes(self, proc):
        for linje in proc.stderr:
            linje = linje.rstrip()
            if not linje:
                continue
            # Nøglen må hverken stå i journalen eller i admin
            if self.noegle:
                linje = linje.replace(self.noegle, '<nøgle>')
            self.linjer.append(linje)
            log(f'ffmpeg: {linje}')

    def sendeformat(self, enhed, video):
        """Det, der skal sendes (sendeformat) — kameraets formater og mikrofon slås op her."""
        if enhed not in self.formater:
            self.formater[enhed] = kamera_formater(enhed)
            if self.formater[enhed]:
                log('kameraet kan: ' + ', '.join(f'{b}x{h}@{max(r)}' for (b, h), r in sorted(self.formater[enhed].items())))
        mikrofon, navn = find_mikrofon(enhed) if video['lyd'] and enhed not in self.uden_mikrofon else (None, None)
        return sendeformat(enhed, video, self.formater[enhed], mikrofon) + (('mikrofon_navn', navn),)

    def start(self, enhed, url, noegle, overlay, fmt=None):
        maal = url.rstrip('/') + '/' + noegle
        fmt = fmt or self.sendeformat(enhed, STANDARD_VIDEO)
        if self.koerer() and self.opsaetning == (enhed, maal, overlay, fmt):
            return
        self.stop()
        if time.monotonic() < self.naeste:
            return
        f = dict(fmt)
        stil_kamera(enhed, f['autofokus'])
        self.noegle = noegle
        self.linjer.clear()
        try:
            self.proc = subprocess.Popen(ffmpeg_args(enhed, maal, overlay, self.koder, fmt),
                                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                         stderr=subprocess.PIPE, text=True, errors='replace')
        except OSError as e:
            self.proc = None
            self.fejl = f'ffmpeg kunne ikke startes: {e}'[:200]
            self._vent()
            return
        threading.Thread(target=self._laes, args=(self.proc,), daemon=True).start()
        self.opsaetning = (enhed, maal, overlay, fmt)
        self.fmt = fmt
        self.startet = time.monotonic()
        (kb, kh), (ub, uh) = f['kamera'], f['ud']
        log(f'sender {ub}x{uh} @ {f["billeder"]}' + (f' (kameraet {kb}x{kh})' if (kb, kh) != (ub, uh) else '') +
            f', {f["kbit"]} kbit/s fra {enhed} ({self.koder}, overlay {overlay or "fra"}, '
            f'lyd {f["mikrofon_navn"] or "fra"})')

    def stop(self):
        if self.proc is None:
            return
        if self.proc.poll() is None:
            # SIGINT: ffmpeg afslutter streamen pænt, så YouTube ser, den er slut
            self.proc.send_signal(signal.SIGINT)
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()
            log('stoppet')
        self.proc = None
        self.opsaetning = None

    def _vent(self):
        pause = GENFORSOEG[min(self.forsoeg, len(GENFORSOEG) - 1)]
        self.forsoeg += 1
        self.naeste = time.monotonic() + pause
        log(f'prøver igen om {pause} s')

    def tjek(self):
        """Efter hver forespørgsel: er ffmpeg død, eller har den kørt stabilt?"""
        if self.proc is None:
            return
        kode = self.proc.poll()
        if kode is None:
            if time.monotonic() - self.startet > STABIL:
                self.forsoeg = 0
                self.fejl = None
            return
        time.sleep(0.2)   # så læsetråden når de sidste linjer
        linjer = list(self.linjer)
        kort = time.monotonic() - self.startet
        f = dict(self.fmt or ())
        enhed = self.opsaetning[0] if self.opsaetning else None
        self.proc = None
        self.opsaetning = None
        if f.get('mikrofon') and MIKROFON_FEJL.search('\n'.join(linjer)):
            # Mikrofonen kunne ikke åbnes: send uden lyd i stedet for slet ikke
            log(f'mikrofonen {f["mikrofon"]} kunne ikke bruges — sender uden lyd fremover')
            self.uden_mikrofon.add(enhed)
            return
        if self.koder == 'vaapi' and kort < VAAPI_TIDLIG and not any(
                re.search(r'rtmp|Connection|Input/output|Network|handshake|/dev/video|busy', l, re.I) for l in linjer):
            # Grafikkortet kunne ikke kode (driver, ældre PC): CPU'en med det samme
            log(f'VAAPI-kodningen stoppede efter {kort:.0f} s (kode {kode}) — koder på CPU\'en fremover')
            self.koder = 'x264'
            return
        self.fejl = forklar(linjer, '{}x{}'.format(*f['kamera']) if f else '1280x720')
        log(f'ffmpeg stoppede (kode {kode}) efter {kort:.0f} s: {self.fejl}')
        self._vent()


def skriv_overlay(linjer):
    os.makedirs(MAPPE, exist_ok=True)
    ny = OVERLAY + '.ny'
    with open(ny, 'w', encoding='utf-8') as f:
        f.write('\n'.join(linjer) if linjer else ' ')
    os.replace(ny, OVERLAY)


_sidste_net_fejl = None


def spoerg(url, token, status):
    """Serverens svar, eller None. Fejlen logges kun, når den skifter (ikke hvert 15. s)."""
    global _sidste_net_fejl
    data = json.dumps(status).encode()
    req = urllib.request.Request(url, data=data, method='POST', headers={
        'Content-Type': 'application/json', 'X-Adgangslink': token,
        'User-Agent': 'badminton-tv-stream'})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            svar = json.loads(r.read().decode('utf-8', 'replace'))
    except urllib.error.HTTPError as e:
        fejl = f'serveren svarede {e.code}'
    except (urllib.error.URLError, OSError, ValueError) as e:
        fejl = f'ingen forbindelse til serveren ({getattr(e, "reason", e)})'
    else:
        if _sidste_net_fejl:
            log('serveren svarer igen')
        _sidste_net_fejl = None
        return svar
    if fejl != _sidste_net_fejl:
        log(fejl)
    _sidste_net_fejl = fejl
    return None


def main():
    stream = Stream()
    stop = threading.Event()

    def afslut(*_):
        stop.set()
    signal.signal(signal.SIGTERM, afslut)
    signal.signal(signal.SIGINT, afslut)

    version = laes_tekst(VERSION_FIL)
    sidste_svar = time.monotonic()
    sidst_kamera = None
    while not stop.is_set():
        tv_url, navn = kiosk_env()
        server, token = adgangslink(tv_url)
        if not server:
            log('TV_URL er ikke et adgangslink (…/t/<kode>) — kan ikke spørge serveren')
            stop.wait(SPOERG_INTET)
            continue
        enhed, kamera = find_kamera()
        if kamera != sidst_kamera:
            log(f'kamera: {kamera} ({enhed})' if kamera else 'intet USB-kamera')
            sidst_kamera = kamera
            # Et andet kamera i stikket kan noget andet
            stream.formater.clear()
            stream.uden_mikrofon.clear()
        # Døde ffmpeg siden sidst? Så skal fejlen med i statussen — og læses,
        # før start() rydder op
        stream.tjek()
        svar = spoerg(STREAM_URL or f'{server}/api/livestream/pc', token, {
            'navn': navn, 'kioskVersion': version, 'kamera': kamera,
            'sender': stream.koerer(), 'koder': stream.koder, 'fejl': stream.fejl,
            'format': stream.format_tekst(), 'mikrofon': stream.mikrofon_navn()})
        if svar is None:
            if stream.koerer() and time.monotonic() - sidste_svar > UDEN_SVAR:
                log(f'intet svar fra serveren i {UDEN_SVAR:.0f} s — stopper')
                stream.stop()
            interval = SPOERG_SENDER if stream.koerer() else SPOERG_FEJL
        else:
            sidste_svar = time.monotonic()
            if svar.get('send') and enhed and svar.get('url') and svar.get('noegle'):
                video = rens_video(svar.get('video'))
                fmt = stream.sendeformat(enhed, video)
                bredde = dict(fmt)['ud'][0]
                logo = hent_logo(server, svar.get('logo')) if svar.get('logo') else None
                overlay = None
                if svar.get('overlay') or logo is not None:
                    # Scoreboardet (og logoet), når serveren sender det, og Pillow er der
                    overlay = 'tavle' if Image is not None and ('tavle' in svar or logo is not None) else 'tekst'
                # Nyt format eller overlay: stop først, så den kørende ffmpeg ikke
                # læser et scoreboard i en ny størrelse (den dør af det)
                if stream.opsaetning and stream.opsaetning[2:] != (overlay, fmt):
                    stream.stop()
                if overlay == 'tavle':
                    skriv_tavle(svar.get('tavle') if svar.get('overlay') else None, video, bredde,
                                logo, svar.get('logo'))
                elif overlay:
                    skriv_overlay(svar.get('linjer') or [])
                stream.start(enhed, svar['url'], svar['noegle'], overlay, fmt)
            else:
                stream.stop()
                if not enhed:
                    stream.fejl = None
            interval = (SPOERG_SENDER if stream.koerer() or svar.get('send')
                        else SPOERG_KLAR if svar.get('kamera') else SPOERG_INTET)
        stream.tjek()
        stop.wait(interval)
    stream.stop()


if __name__ == '__main__':
    sys.exit(main())
