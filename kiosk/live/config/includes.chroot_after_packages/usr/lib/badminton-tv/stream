LOGO_MAX_BYTES = 5 * 1024 * 1024
LOGO_IGEN = _tal('BT_LOGO_IGEN', 60)   # et logo, der ikke kunne hentes, prøves igen efter så længe
_logoer = collections.OrderedDict()    # adresse -> Pillow-billede (de seneste: sponsorer og klubber skifter)
_logo_fejl = {}                        # adresse -> tidspunkt for seneste fejl


def hent_logo(server, sti):
    """Logoet fra serverens /uploads/… som RGBA-billede, eller None. Hentes én gang."""
    if Image is None or not isinstance(sti, str) or '..' in sti or \
            not re.match(r'^/uploads/[A-Za-z0-9_./-]+\.(png|jpe?g|webp|gif)$', sti, re.I):
        return None
    if sti in _logoer:
        _logoer.move_to_end(sti)
        return _logoer[sti]
    if time.monotonic() - _logo_fejl.get(sti, -LOGO_IGEN) < LOGO_IGEN:
        return None
    try:
        req = urllib.request.Request(server + sti, headers={'User-Agent': 'badminton-tv-stream'})
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            data = r.read(LOGO_MAX_BYTES + 1)
        if len(data) > LOGO_MAX_BYTES:
            raise ValueError('for stort')
        billede = Image.open(io.BytesIO(data))
        billede.thumbnail((1920, 1080))
        billede = billede.convert('RGBA')
    except (urllib.error.URLError, OSError, ValueError) as e:
        log(f'logoet kunne ikke hentes ({sti}): {getattr(e, "reason", e)}')
        _logo_fejl[sti] = time.monotonic()
        return None
    _logoer[sti] = billede
    while len(_logoer) > 24:
        _logoer.popitem(last=False)
    return billede


# ffmpeg kunne ikke åbne kameraet i det inputformat (og den størrelse), den bad om.
# Kun v4l2's egne linjer: "Invalid argument" fra fx kodningen er en anden fejl
KAMERA_FORMAT_FEJL = re.compile(r'Cannot find a proper format|video4linux2.*(not supported|Invalid argument)|'
                                r'/dev/video\d+: Invalid argument', re.I)
FEJLLOG_LINJER = 10     # ffmpegs sidste linjer til admin, når den stopper med en fejl


def forklar(linjer, str_='1280x720', input_='mjpeg'):
    """ffmpegs fejl i ord, admin kan bruge. str_ og input_: det, kameraet blev bedt om."""
    alt = '\n'.join(linjer)
    if MIKROFON_FEJL.search(alt):
        return 'Kameraets mikrofon kunne ikke bruges — sender uden lyd'
    if re.search(r'Device or resource busy', alt):
        return 'Kameraet er optaget af et andet program'
    if re.search(r'No such file or directory|No such device', alt) and '/dev/video' in alt:
        return 'Kameraet forsvandt — sidder USB-kablet ordentligt?'
    if re.search(r'Connection refused|Connection reset|Broken pipe|Input/output error|'
                 r'Server returned 4|Server error|Error in the pull function|handshake', alt, re.I):
        return 'YouTube afviste forbindelsen — tjek stream-nøglen, og at kanalen må sende live'
    if re.search(r'Network is unreachable|Name or service not known|Temporary failure in name resolution|'
                 r'timed out', alt, re.I):
        return 'Ingen forbindelse til YouTube — nettet i hallen?'
    if KAMERA_FORMAT_FEJL.search(alt):
        return (f'Kameraet kunne ikke åbnes som {INPUT_NAVN.get(input_, input_)} {str_} — sidder det i en '
                f'USB-hub eller forlænger, så prøv direkte i PC\'en, ellers et andet kamera')
    return (linjer[-1] if linjer else 'ffmpeg stoppede uden besked')[:200]


MIKROFON_FEJL = re.compile(r'\balsa\b|plughw:|cannot open audio device|ALSA', re.I)


class Stream:
    def __init__(self):
        self.proc = None
        self.noegle = ''
        self.opsaetning = None      # (enhed, maal, overlay, format) for den kørende
        self.fmt = None             # sendeformat() for den kørende
        self.startet = 0
        self.fejl = None
        self.fejllog = None         # ffmpegs sidste linjer til fejlen (admin)
        self.forsoeg = 0
        self.naeste = 0             # tidligst næste start efter en fejl
        self.koder = 'vaapi' if os.path.exists(RENDER) else 'x264'
        self.uden_mikrofon = set()  # kameraer, hvis mikrofon ikke kunne bruges
        self.formater = {}          # enhed -> kamera_undersoeg() (et svar gemmes)
        self.uden_svar = {}         # enhed -> hvornår v4l2-ctl sidst ikke svarede
        self.billede = {}           # (enhed, ctime) -> (proev_billede(), kroma) — et svar gemmes
        self.uden_billede = {}      # enhed -> hvornår prøvebilledet sidst ikke kunne optages
        self.afvist = {}            # enhed -> inputformater, kameraet ikke kunne åbnes i
        self.linjer = collections.deque(maxlen=20)

    def format_tekst(self):
        """Til admin: det, der faktisk sendes, fx '1280x720@30' (None: sender ikke)."""
        if not self.koerer() or not self.fmt:
            return None
        f = dict(self.fmt)
        return f'{f["ud"][0]}x{f["ud"][1]}@{f["billeder"]}'

    def mikrofon_navn(self):
        return dict(self.fmt).get('mikrofon_navn') if self.koerer() and self.fmt else None

    def koerer(self):
        return self.proc is not None and self.proc.poll() is None

    def _laes(self, proc):
        for linje in proc.stderr:
            linje = linje.rstrip()
            if not linje:
                continue
            # Nøglen må hverken stå i journalen eller i admin
            if self.noegle:
                linje = linje.replace(self.noegle, '<nøgle>')
            self.linjer.append(linje)
            log(f'ffmpeg: {linje}')

    def kameraets_info(self, enhed):
        """kamera_undersoeg() for enheden. Et svar gemmes (og logges) én gang pr. kamera.
        Et tomt svar gemmes IKKE: v4l2-ctl kan spørge, før kameraet er klar ved opstart,
        og blev "ingen formater" husket, vandt et infrarødt kamera ved siden af for
        altid. Det spørges igen (højst hvert UNDERSOEG_IGEN sekund)."""
        if enhed in self.formater:
            return self.formater[enhed]
        if time.monotonic() - self.uden_svar.get(enhed, -UNDERSOEG_IGEN) < UNDERSOEG_IGEN:
            return {}, set()
        formater, navne = kamera_undersoeg(enhed)
        if not navne:
            if enhed not in self.uden_svar:
                log(f'{enhed}: v4l2-ctl svarede ikke (kameraet er måske ikke klar endnu) — spørges igen')
            self.uden_svar[enhed] = time.monotonic()
            return formater, navne
        self.uden_svar.pop(enhed, None)
        self.formater[enhed] = (formater, navne)
        for n in INPUT_ORDEN:
            if formater.get(n):
                log(f'{enhed}: ' + ('kameraet kan: ' if n == 'mjpeg' else f'kameraet kan ({INPUT_NAVN[n]}): ') +
                    ', '.join(f'{b}x{h}@{max(r)}' for (b, h), r in sorted(formater[n].items())))
        if not formater:
            log(f'{enhed}: kan kun {", ".join(sorted(navne))} — intet, vi kan sende')
        return formater, navne

    def kameraets_formater(self, enhed):
        """kamera_formater() for enheden (fra kameraets_info)."""
        return self.kameraets_info(enhed)[0]

    def _billede_noegle(self, enhed):
        try:
            return enhed, os.stat(enhed).st_ctime   # sat i igen: optages igen
        except OSError:
            return enhed, None

    def kameraets_billede(self, enhed, formater):
        """proev_billede() for enheden: 'farve', 'graa' eller None. Et svar gemmes,
        til kameraet sættes i igen; kunne der ikke optages, prøves igen senere. Den
        enhed, der sender lige nu, er i brug — dér bruges det gemte svar."""
        noegle = self._billede_noegle(enhed)
        if noegle in self.billede:
            return self.billede[noegle][0]
        if self.koerer() and self.opsaetning and self.opsaetning[0] == enhed:
            return None
        if time.monotonic() - self.uden_billede.get(enhed, -UNDERSOEG_IGEN) < UNDERSOEG_IGEN:
            return None
        res, kroma = proev_billede(enhed, formater)
        if res is None:
            if enhed not in self.uden_billede:
                log(f'{enhed}: prøvebilledet kunne ikke optages — prøver igen')
            self.uden_billede[enhed] = time.monotonic()
            return None
        self.uden_billede.pop(enhed, None)
        self.billede[noegle] = (res, kroma)
        log(f'{enhed}: prøvebillede ' + (f'i farver (farvemætning {kroma})' if res == 'farve'
                                          else f'GRÅT (farvemætning {kroma}) — et infrarødt kamera'))
        return res

    def kamera_liste(self):
        """Til admin: PC'ens kameraer (højst 6), så et bestemt kan vælges, hvis det
        automatiske valg en dag tager fejl: by-id-link, navn, interface, bedste
        format og prøvebilledet (hvis det er optaget)."""
        liste = []
        for sti, enhed in kamera_links()[:6]:
            formater = self.formater.get(enhed, ({}, set()))[0]
            bedste = None
            for n in INPUT_ORDEN:
                if formater.get(n):
                    b, h = max(formater[n], key=lambda s: s[0] * s[1])
                    bedste = f'{INPUT_NAVN[n]} {b}x{h}'
                    break
            billede = self.billede.get(self._billede_noegle(enhed))
            liste.append({'id': os.path.basename(sti), 'navn': kamera_navn(sti, enhed),
                          'node': os.path.basename(enhed), 'interface': interface_nr(sti),
                          'format': bedste, 'billede': billede[0] if billede else None})
        return liste

    def node_tekst(self):
        """Til admin: den node, der sender, fx 'video0 · interface 00'."""
        if not self.koerer() or not self.opsaetning:
            return None
        enhed = self.opsaetning[0]
        sti = next((s for s, e in kamera_links() if e == enhed), None)
        nr = interface_nr(sti)
        return os.path.basename(enhed) + (f' · interface {nr}' if nr else '')

    def input_tekst(self):
        """Til admin: det, kameraet leverer til den kørende stream, fx 'MJPEG 1920x1080'
        (et infrarødt kamera ses som fx 'YUYV 640x360')."""
        if not self.koerer() or not self.fmt:
            return None
        f = dict(self.fmt)
        return f'{INPUT_NAVN.get(f["input"], f["input"])} {f["kamera"][0]}x{f["kamera"][1]}'

    def formater_tekst(self, enhed):
        """Til admin: det, kameraet selv siger, det kan — de største først, fx
        'MJPEG 1920x1080@30, 1280x720@60 · YUYV 640x480@30'. Mangler MJPEG her, sidder
        kameraet ofte i en USB-hub/-forlænger eller på USB 1.1-fart."""
        if not enhed:
            return None
        alle = self.kameraets_formater(enhed)
        if not alle:
            return 'ukendt (kameraet svarede ikke)'
        dele = []
        for n in INPUT_ORDEN:
            f = sorted(alle.get(n, {}).items(), key=lambda x: (-x[0][1], -x[0][0]))
            if f:
                dele.append(INPUT_NAVN[n] + ' ' + ', '.join(f'{b}x{h}@{max(r)}' for (b, h), r in f[:6]) +
                            (' …' if len(f) > 6 else ''))
        return ' · '.join(dele)

    def sendeformat(self, enhed, video):
        """Det, der skal sendes (sendeformat) — kameraets formater og mikrofon slås op her."""
        input_, formater = vaelg_input(self.kameraets_formater(enhed), self.afvist.get(enhed, ()))
        mikrofon, navn = find_mikrofon(enhed) if video['lyd'] and enhed not in self.uden_mikrofon else (None, None)
        return sendeformat(enhed, video, formater, mikrofon, input_) + (('mikrofon_navn', navn),)

    def start(self, enhed, url, noegle, overlay, fmt=None):
        maal = url.rstrip('/') + '/' + noegle
        fmt = fmt or self.sendeformat(enhed, STANDARD_VIDEO)
        if self.koerer() and self.opsaetning == (enhed, maal, overlay, fmt):
            return
        self.stop()
        if time.monotonic() < self.naeste:
            return
        f = dict(fmt)
        stil_kamera(enhed, f['autofokus'])
        self.noegle = noegle
        self.linjer.clear()
        try:
            self.proc = subprocess.Popen(ffmpeg_args(enhed, maal, overlay, self.koder, fmt),
                                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                         stderr=subprocess.PIPE, text=True, errors='replace')
        except OSError as e:
            self.proc = None
            self.fejl = f'ffmpeg kunne ikke startes: {e}'[:200]
            self.fejllog = None
            self._vent()
            return
        threading.Thread(target=self._laes, args=(self.proc,), daemon=True).start()
        self.opsaetning = (enhed, maal, overlay, fmt)
        self.fmt = fmt
        self.startet = time.monotonic()
        (kb, kh), (ub, uh) = f['kamera'], f['ud']
        log(f'sender {ub}x{uh} @ {f["billeder"]}' + (f' (kameraet {kb}x{kh})' if (kb, kh) != (ub, uh) else '') +
            f', {f["kbit"]} kbit/s fra {enhed} ({self.koder}, overlay {overlay or "fra"}, '
            f'lyd {f["mikrofon_navn"] or "fra"})')

    def stop(self):
        if self.proc is None:
            return
        if self.proc.poll() is None:
            # SIGINT: ffmpeg afslutter streamen pænt, så YouTube ser, den er slut
            self.proc.send_signal(signal.SIGINT)
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()
            log('stoppet')
        self.proc = None
        self.opsaetning = None

    def _vent(self):
        pause = GENFORSOEG[min(self.forsoeg, len(GENFORSOEG) - 1)]
        self.forsoeg += 1
        self.naeste = time.monotonic() + pause
        log(f'prøver igen om {pause} s')

    def tjek(self):
        """Efter hver forespørgsel: er ffmpeg død, eller har den kørt stabilt?"""
        if self.proc is None:
            return
        kode = self.proc.poll()
        if kode is None:
            if time.monotonic() - self.startet > STABIL:
                self.forsoeg = 0
                self.fejl = self.fejllog = None
            return
        time.sleep(0.2)   # så læsetråden når de sidste linjer
        linjer = list(self.linjer)
        kort = time.monotonic() - self.startet
        f = dict(self.fmt or ())
        enhed = self.opsaetning[0] if self.opsaetning else None
        self.proc = None
        self.opsaetning = None
        if f.get('mikrofon') and MIKROFON_FEJL.search('\n'.join(linjer)):
            # Mikrofonen kunne ikke åbnes: send uden lyd i stedet for slet ikke
            log(f'mikrofonen {f["mikrofon"]} kunne ikke bruges — sender uden lyd fremover')
            self.uden_mikrofon.add(enhed)
            return
        afvist = self.afvist.setdefault(enhed, set())
        if (f and kort < VAAPI_TIDLIG and KAMERA_FORMAT_FEJL.search('\n'.join(linjer))
                and f['input'] not in afvist and len(afvist) < len(INPUT_ORDEN) - 1):
            # Kameraet kunne ikke åbnes i formatet (fx intet MJPEG): det næste med det samme
            afvist.add(f['input'])
            log(f'kameraet kunne ikke åbnes som {INPUT_NAVN.get(f["input"], f["input"])} — prøver '
                f'{INPUT_NAVN[vaelg_input(self.formater.get(enhed, {}), afvist)[0]]}')
            return
        if self.koder == 'vaapi' and kort < VAAPI_TIDLIG and not any(
                re.search(r'rtmp|Connection|Input/output|Network|handshake|/dev/video|busy', l, re.I) for l in linjer):
            # Grafikkortet kunne ikke kode (driver, ældre PC): CPU'en med det samme
            log(f'VAAPI-kodningen stoppede efter {kort:.0f} s (kode {kode}) — koder på CPU\'en fremover')
            self.koder = 'x264'
            return
        self.fejl = forklar(linjer, '{}x{}'.format(*f['kamera']) if f else '1280x720', f.get('input', 'mjpeg'))
        # ffmpegs egne ord med til admin (nøglen er allerede skiftet ud i _laes)
        self.fejllog = linjer[-FEJLLOG_LINJER:] or None
        log(f'ffmpeg stoppede (kode {kode}) efter {kort:.0f} s: {self.fejl}')
        self._vent()


def skriv_overlay(linjer):
    os.makedirs(MAPPE, exist_ok=True)
    ny = OVERLAY + '.ny'
    with open(ny, 'w', encoding='utf-8') as f:
        f.write('\n'.join(linjer) if linjer else ' ')
    os.replace(ny, OVERLAY)


_sidste_net_fejl = None


def maskine_id():
    """PC'ens id over for serveren: et hash af /etc/machine-id (selve id'et sendes
    ikke). Bruger flere TV-PC'er samme adgangslink, sender kun én af dem banen."""
    mid = laes_tekst('/etc/machine-id')
    return hashlib.sha256(('badminton-tv:' + mid).encode()).hexdigest()[:32] if mid else None


def spoerg(url, token, status):
    """Serverens svar, eller None. Fejlen logges kun, når den skifter (ikke hvert 15. s)."""
    global _sidste_net_fejl
    data = json.dumps(status).encode()
    req = urllib.request.Request(url, data=data, method='POST', headers={
        'Content-Type': 'application/json', 'X-Adgangslink': token,
        'User-Agent': 'badminton-tv-stream'})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            svar = json.loads(r.read().decode('utf-8', 'replace'))
    except urllib.error.HTTPError as e:
        fejl = f'serveren svarede {e.code}'
    except (urllib.error.URLError, OSError, ValueError) as e:
        fejl = f'ingen forbindelse til serveren ({getattr(e, "reason", e)})'
    else:
        if _sidste_net_fejl:
            log('serveren svarer igen')
        _sidste_net_fejl = None
        return svar
    if fejl != _sidste_net_fejl:
        log(fejl)
    _sidste_net_fejl = fejl
    return None


def main():
    stream = Stream()
    stop = threading.Event()

    def afslut(*_):
        stop.set()
    signal.signal(signal.SIGTERM, afslut)
    signal.signal(signal.SIGINT, afslut)

    version = laes_tekst(VERSION_FIL)
    pc_id = maskine_id()
    sidste_svar = time.monotonic()
    sidst_kamera = None
    sidst_anden = False
    valgt = None            # by-id-linket, admin har valgt for PC'en (serverens seneste svar)
    while not stop.is_set():
        tv_url, navn = kiosk_env()
        server, token = adgangslink(tv_url)
        if not server:
            log('TV_URL er ikke et adgangslink (…/t/<kode>) — kan ikke spørge serveren')
            stop.wait(SPOERG_INTET)
            continue
        # Hver gang: svarer et kamera først nu (eller sættes et bedre i), skiftes der —
        # også midt i en udsendelse (start() genstarter ffmpeg på den nye enhed)
        enhed, kamera = find_kamera(stream.kameraets_info, stream.kameraets_billede, valgt)
        # Kameraet taget ud og sat i igen (fx i et andet stik): enheden oprettes på
        # ny — og formaterne kan være andre (USB 1.1-fart i en hub har intet MJPEG)
        try:
            kamera_id = (kamera, enhed, os.stat(enhed).st_ctime if enhed else None)
        except OSError:
            kamera_id = (kamera, enhed, None)
        if kamera_id != sidst_kamera:
            if kamera != (sidst_kamera or (None,))[0]:
                log(f'kamera: {kamera} ({enhed})' if kamera else 'intet USB-kamera')
            else:
                log(f'kameraet er sat i igen ({enhed})')
            sidst_kamera = kamera_id
            # Et andet kamera i stikket kan noget andet
            stream.formater.clear()
            stream.afvist.clear()
            stream.uden_mikrofon.clear()
            stream.uden_svar.clear()
        # Døde ffmpeg siden sidst? Så skal fejlen med i statussen — og læses,
        # før start() rydder op
        stream.tjek()
        svar = spoerg(STREAM_URL or f'{server}/api/livestream/pc', token, {
            'navn': navn, 'kioskVersion': version, 'kamera': kamera,
            'sender': stream.koerer(), 'koder': stream.koder, 'fejl': stream.fejl,
            'format': stream.format_tekst(), 'mikrofon': stream.mikrofon_navn(), 'pcId': pc_id,
            'kameraFormater': stream.formater_tekst(enhed), 'fejllog': stream.fejllog,
            'kameraInput': stream.input_tekst(), 'kameraNode': stream.node_tekst(),
            'kameraer': stream.kamera_liste()})
        if svar is None:
            if stream.koerer() and time.monotonic() - sidste_svar > UDEN_SVAR:
                log(f'intet svar fra serveren i {UDEN_SVAR:.0f} s — stopper')
                stream.stop()
            interval = SPOERG_SENDER if stream.koerer() else SPOERG_FEJL
        else:
            sidste_svar = time.monotonic()
            k = svar.get('kameraEnhed')
            valgt = k if isinstance(k, str) and re.fullmatch(r'[\w.:+-]{1,160}', k) else None
            anden = svar.get('grund') == 'anden-pc'
            if anden != sidst_anden:
                log('en anden TV-PC på samme adgangslink sender banen — sender ikke' if anden
                    else 'ingen anden TV-PC sender banen længere')
                sidst_anden = anden
            if svar.get('send') and enhed and svar.get('url') and svar.get('noegle'):
                video = rens_video(svar.get('video'))
                fmt = stream.sendeformat(enhed, video)
                bredde = dict(fmt)['ud'][0]
                logo = hent_logo(server, svar.get('logo')) if svar.get('logo') else None
                overlay = None
                if svar.get('overlay') or logo is not None:
                    # Scoreboardet (og logoet), når serveren sender det, og Pillow er der
                    overlay = 'tavle' if Image is not None and ('tavle' in svar or logo is not None) else 'tekst'
                # Nyt format eller overlay: stop først, så den kørende ffmpeg ikke
                # læser et scoreboard i en ny størrelse (den dør af det)
                if stream.opsaetning and stream.opsaetning[2:] != (overlay, fmt):
                    stream.stop()
                if overlay == 'tavle':
                    tavle = svar.get('tavle') if svar.get('overlay') else None
                    # Klublogoerne ud for navnene (nye servere) — hentes én gang hver
                    adresser = (tavle or {}).get('logoer') if isinstance(tavle, dict) else None
                    navn_logoer = tuple(hent_logo(server, a) if a else None
                                        for a in (adresser if isinstance(adresser, list) and len(adresser) == 2
                                                  else (None, None)))
                    skriv_tavle(tavle, video, bredde, logo, svar.get('logo'), navn_logoer)
                elif overlay:
                    skriv_overlay(svar.get('linjer') or [])
                stream.start(enhed, svar['url'], svar['noegle'], overlay, fmt)
            else:
                stream.stop()
                if not enhed:
                    stream.fejl = stream.fejllog = None
            interval = (SPOERG_SENDER if stream.koerer() or svar.get('send')
                        else SPOERG_KLAR if svar.get('kamera') else SPOERG_INTET)
        stream.tjek()
        stop.wait(interval)
    stream.stop()


if __name__ == '__main__':
    sys.exit(main())
