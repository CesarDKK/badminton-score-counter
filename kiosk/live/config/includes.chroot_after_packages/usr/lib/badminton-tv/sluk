#!/bin/bash
# Automatisk slukning (SLUK_KL, standard 23:59), hvis ingen har slukket PC'en
# manuelt. Henter en ny version af Badminton TV lige inden — det er det
# eneste tidspunkt, hvor vi ved at ingen kigger på skærmen, og hallens net
# ikke bruges til livestream (nr. 102).
#
# Der installeres ikke længere pakker fra Debian om natten (nr. 98): de gik
# uden om A/B-opdateringen, så en dårlig pakke ramte alle PC'er på én nat
# uden vej tilbage. Sikkerhedsrettelserne kommer nu med appens egne
# udgivelser (hele systemet bygges forfra og udrulles med prøvestart).
#
# Startes af badminton-tv-sluk.timer, som genereres ud fra kiosk.conf.

set -u
TTY=/dev/tty1

besked() { printf '\033[2J\033[H\n\n   %s\n' "$1" > "$TTY" 2>/dev/null; echo "$1"; }

# Samme store skrift som installationen — standardskriften mangler bl.a. tankestreg.
skrift() {
    local f
    for f in /usr/share/consolefonts/Uni3-TerminusBold32x16.psf.gz \
             /usr/share/consolefonts/Uni2-TerminusBold32x16.psf.gz; do
        [ -f "$f" ] && { setfont -C "$TTY" "$f" 2>/dev/null || true; return; }
    done
}

# Uret skal være sat fra internettet. Første gang efter Windows står BIOS-uret
# på dansk tid, som Linux læser som UTC — så ville PC'en tro, at klokken var
# 23:59 to timer for tidligt. Hellere lade den køre natten over end slukke midt
# i en kamp.
if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != yes ]; then
    echo "Uret er ikke synkroniseret med internettet — springer automatisk slukning over."
    exit 0
fi

# Stop browseren først. En hentning, der er i gang fra dagen (timeren eller
# "Installér nyeste nu"), stoppes også — den fortsætter herunder, hvor den slap.
systemctl stop badminton-tv.service badminton-tv-opdatering.service \
    badminton-tv-opdatering-spoerg.timer badminton-tv-opdatering-spoerg.service
setterm --term linux --blank 0 --cursor off > "$TTY" 2>/dev/null
skrift
besked "Badminton TV slukker - tjekker først for en ny version (det kan tage et par minutter) ..."

# BT_NAT=1: nu må den nye version hentes i fuld fart (OPDATERING=auto venter
# på slukningen). Den startes først ved næste opstart — med prøvestart.
BT_NAT=1 timeout 40m /usr/lib/badminton-tv/opdatering tjek \
    || echo "Tjekket for en ny version blev ikke færdigt — prøver igen i morgen."

besked "Badminton TV slukker ..."
# Planlagt — rapporten (/usr/lib/badminton-tv/rapport) skal ikke melde det
mkdir -p /run/badminton-tv && echo sluk > /run/badminton-tv/nedlukning
systemctl poweroff
