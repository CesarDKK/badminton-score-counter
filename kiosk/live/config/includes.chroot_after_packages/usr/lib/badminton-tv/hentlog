#!/bin/bash
# Henter fejlloggen fra en installeret Badminton TV-PC ned på USB-nøglen.
#
# Kører på skærmen (tty1), når PC'en er bootet fra USB-nøglen med "Hent
# fejllog". Intet på PC'en ændres: dens disk monteres skrivebeskyttet. Bruges
# når en PC er frosset, og man ikke kan sidde ved den og fejlsøge — loggen
# tages med hjem på nøglen og læses på en Windows-PC.
#
# Live-systemet er kopieret ind i RAM (toram), så nøglen er fri til at skrive
# på og kan tages ud til sidst.
#
# På nøglen: fejllog\<PC-navn>-<dato>-<tid>\
#   OVERSIGT.txt              PC, version, alle opstarter — uren afslutning markeret
#   opstart-NN-<dato>.txt     kernebeskeder + advarsler + slutningen af hver opstart
#   kernenedbrud\             pstore-dumps (kerne-panik), hvis der er nogen
#   kiosk.conf.txt            uden WiFi-kode
#   andet-system\             det samme fra PC'ens andet system (A/B), hvis det
#                             har kørt — fx en opdatering, der ikke blev godkendt

set -uo pipefail
. /usr/lib/badminton-tv/conf.sh

PC=/mnt/badminton-pc
USB_MNT=/run/badminton-usb
TMP=/run/badminton-tv/fejllog
ANTAL_OPSTARTER=15

mkdir -p "$PC" "$USB_MNT" "$TMP"

# ── Skærm (som installeren) ────────────────────────────────
R=$'\033[1;31m' G=$'\033[1;32m' Y=$'\033[1;33m' B=$'\033[1;36m' F=$'\033[1m' N=$'\033[0m'
for font in /usr/share/consolefonts/Uni3-TerminusBold32x16.psf.gz \
            /usr/share/consolefonts/Uni2-TerminusBold32x16.psf.gz; do
    [ -f "$font" ] && { setfont "$font" 2>/dev/null || true; break; }
done
setterm --blank 0 --powerdown 0 --cursor off 2>/dev/null || true

printf '\033[2J\033[H'
printf '\n  %s══════════════════════════════════════════════════════%s\n' "$B" "$N"
printf '  %s  BADMINTON TV — HENT FEJLLOG%s\n' "$F" "$N"
printf '  %s══════════════════════════════════════════════════════%s\n\n' "$B" "$N"
printf "  Intet på PC'ens disk bliver ændret.\n\n"

trin() { printf '  %s»%s %s' "$B" "$N" "$1"; }
okay() { printf ' %sOK%s\n' "$G" "$N"; }
stop() {
    printf " %sFEJL%s\n\n  %s\n\n  Sluk PC'en med tænd/sluk-knappen.\n" "$R" "$N" "$1"
    while true; do sleep 3600; done
}

# ── 1. USB-nøglen ──────────────────────────────────────────
trin "Finder USB-nøglen…"
USB_PART=''
for _ in 1 2 3 4 5; do
    while read -r navn fstype; do
        case "$fstype" in vfat|exfat) ;; *) continue ;; esac
        if mount -o ro "$navn" "$USB_MNT" 2>/dev/null; then
            if [ -f "$USB_MNT/live/filesystem.squashfs" ]; then
                USB_PART=$navn
                break 2
            fi
            umount "$USB_MNT"
        fi
    done < <(lsblk -lnpo NAME,FSTYPE)
    sleep 1
done
[ -n "$USB_PART" ] || stop "USB-nøglen blev ikke fundet."
umount "$USB_MNT"
okay

# ── 2. PC'ens installerede system(er) ──────────────────────
# PC'en har to systemer, A og B (se rod.sh) — eller ét, hvis den er installeret
# før den automatiske opdatering. Det aktive står i badminton-tv.env på
# EFI-partitionen. Det andet system kommer også med: gik en opdatering galt,
# ligger loggen fra forsøget dér.
trin "Finder Badminton TV på PC'ens disk…"
for _ in 1 2 3 4 5; do
    ROD_A=$(blkid -L badminton-tv-a 2>/dev/null || true)
    ROD_B=$(blkid -L badminton-tv-b 2>/dev/null || true)
    ROD_GL=$(blkid -L badminton-tv 2>/dev/null || true)
    [ -n "$ROD_A$ROD_GL" ] && break
    sleep 1
done
BTENV=''
AKTIV=a
if [ -n "$ROD_A" ]; then
    DISK=/dev/$(lsblk -no PKNAME "$ROD_A" | head -1)
    ESP_MNT=/run/badminton-esp
    mkdir -p "$ESP_MNT"
    for p in $(lsblk -lnpo NAME,FSTYPE "$DISK" | awk '$2 == "vfat" { print $1 }'); do
        mount -o ro "$p" "$ESP_MNT" 2>/dev/null || continue
        if [ -f "$ESP_MNT/EFI/debian/badminton-tv.env" ]; then
            BTENV=$(grep -v '^#' "$ESP_MNT/EFI/debian/badminton-tv.env")
            umount "$ESP_MNT"
            break
        fi
        umount "$ESP_MNT"
    done
    [ "$(printf '%s\n' "$BTENV" | sed -n 's/^aktiv=//p')" = b ] && AKTIV=b
fi
if [ -n "$ROD_GL" ]; then
    HOVED=$ROD_GL ANDET=''
elif [ "$AKTIV" = b ]; then
    HOVED=$ROD_B ANDET=$ROD_A
else
    HOVED=$ROD_A ANDET=$ROD_B
fi
[ -n "$HOVED" ] || stop "PC'en har ikke Badminton TV installeret (ingen disk med navnet badminton-tv)."

# noload: et frosset system er slukket hårdt, og ext4's journal må IKKE
# afspilles — det ville skrive på disken
monter() {
    mount -o ro,noload "$1" "$PC" 2>/dev/null || mount -o ro "$1" "$PC" 2>/dev/null
}
monter "$HOVED" || stop "PC'ens disk ($HOVED) kunne ikke åbnes."
NAVN=$(tr -cd 'A-Za-z0-9._-' < "$PC/etc/hostname" 2>/dev/null)
umount "$PC"
okay

[ -n "$NAVN" ] || NAVN=ukendt-pc
MAPPE="$NAVN-$(date '+%Y-%m-%d-%H%M')"
UD_ROD=$TMP/$MAPPE

# Indsamlingen er fælles med "Hent fejllog" fra admin (fejllog.sh)
. /usr/lib/badminton-tv/fejllog.sh
USB_VERSION=$(cat /usr/share/badminton-tv/version 2>/dev/null || echo ukendt)

# saml ENHED MAPPE BESKRIVELSE — ét systems oversigt, log og konfiguration.
saml() {
    local enhed=$1 ud=$2 beskrivelse=$3
    mkdir -p "$ud"
    if ! monter "$enhed"; then
        printf 'Kunne ikke åbne %s\n' "$enhed" > "$ud/OVERSIGT.txt"
        return
    fi
    FL_ROD=$PC FL_ANTAL=$ANTAL_OPSTARTER FL_BTENV=$BTENV FL_EKSTRA="USB-nøglens version: $USB_VERSION" \
        fejllog_saml "$ud" "$beskrivelse ($enhed)" "$NAVN"
    umount "$PC" 2>/dev/null
}

# ── 3. Loggen ──────────────────────────────────────────────
trin "Kopierer loggen fra de seneste $ANTAL_OPSTARTER opstarter…"
if [ -n "$ROD_GL" ]; then
    saml "$HOVED" "$UD_ROD" "det eneste system"
else
    saml "$HOVED" "$UD_ROD" "system ${AKTIV^^} — det aktive"
    # Har det andet system kørt (versionen før den seneste opdatering, eller
    # en opdatering der ikke blev godkendt), kommer dets log med i en undermappe.
    if [ "$AKTIV" = a ]; then ANDET_NAVN=B; else ANDET_NAVN=A; fi
    if [ -n "$ANDET" ] && monter "$ANDET"; then
        HAR_LOG=''
        [ -d "$PC/var/log/journal" ] && HAR_LOG=1
        umount "$PC"
        if [ -n "$HAR_LOG" ]; then
            saml "$ANDET" "$UD_ROD/andet-system" \
                "system $ANDET_NAVN — det inaktive (versionen før, eller en opdatering der ikke blev godkendt)"
        fi
    fi
fi
okay

# ── 4. Ned på USB-nøglen ───────────────────────────────────
trin "Gemmer på USB-nøglen…"
mount -o rw "$USB_PART" "$USB_MNT" 2>/dev/null || stop "USB-nøglen kunne ikke skrives på."
# CRLF, så filerne ser rigtige ud i Windows' Notesblok
(cd "$UD_ROD" && find . -type f) | while read -r f; do
    mkdir -p "$USB_MNT/fejllog/$MAPPE/$(dirname "$f")"
    case "$f" in
        *.txt) sed 's/$/\r/' "$UD_ROD/$f" > "$USB_MNT/fejllog/$MAPPE/$f" ;;
        *)     cp "$UD_ROD/$f" "$USB_MNT/fejllog/$MAPPE/$f" ;;
    esac
done
sync
umount "$USB_MNT"
okay

# ── Færdig ─────────────────────────────────────────────────
uren=$(grep -c 'IKKE LUKKET NED' "$UD_ROD/OVERSIGT.txt" || true)
printf '\n  %sFærdig.%s Fejlloggen ligger på USB-nøglen i mappen:\n\n' "$G" "$N"
printf '    %sfejllog\\%s%s\n\n' "$F" "$MAPPE" "$N"
if [ "${uren:-0}" -gt 0 ]; then
    printf '  %s%s opstart(er) endte uden normal nedlukning%s (frøs eller mistede strømmen).\n\n' "$Y" "$uren" "$N"
fi
printf "  Tag USB-nøglen ud, og sluk PC'en med tænd/sluk-knappen.\n"
printf '  Starter den igen uden nøglen, kører den som TV som før.\n'
while true; do sleep 3600; done
