#!/bin/bash
# Henter fejlloggen fra en installeret Badminton TV-PC ned på USB-nøglen.
#
# Kører på skærmen (tty1), når PC'en er bootet fra USB-nøglen med "Hent
# fejllog". Intet på PC'en ændres: dens disk monteres skrivebeskyttet. Bruges
# når en PC er frosset, og man ikke kan sidde ved den og fejlsøge — loggen
# tages med hjem på nøglen og læses på en Windows-PC.
#
# Live-systemet er kopieret ind i RAM (toram), så nøglen er fri til at skrive
# på og kan tages ud til sidst.
#
# På nøglen: fejllog\<PC-navn>-<dato>-<tid>\
#   OVERSIGT.txt              PC, version, alle opstarter — uren afslutning markeret
#   opstart-NN-<dato>.txt     kernebeskeder + advarsler + slutningen af hver opstart
#   kernenedbrud\             pstore-dumps (kerne-panik), hvis der er nogen
#   kiosk.conf.txt            uden WiFi-kode

set -uo pipefail
. /usr/lib/badminton-tv/conf.sh

PC=/mnt/badminton-pc
USB_MNT=/run/badminton-usb
TMP=/run/badminton-tv/fejllog
ANTAL_OPSTARTER=15

mkdir -p "$PC" "$USB_MNT" "$TMP"

# ── Skærm (som installeren) ────────────────────────────────
R=$'\033[1;31m' G=$'\033[1;32m' Y=$'\033[1;33m' B=$'\033[1;36m' F=$'\033[1m' N=$'\033[0m'
for font in /usr/share/consolefonts/Uni3-TerminusBold32x16.psf.gz \
            /usr/share/consolefonts/Uni2-TerminusBold32x16.psf.gz; do
    [ -f "$font" ] && { setfont "$font" 2>/dev/null || true; break; }
done
setterm --blank 0 --powerdown 0 --cursor off 2>/dev/null || true

printf '\033[2J\033[H'
printf '\n  %s══════════════════════════════════════════════════════%s\n' "$B" "$N"
printf '  %s  BADMINTON TV — HENT FEJLLOG%s\n' "$F" "$N"
printf '  %s══════════════════════════════════════════════════════%s\n\n' "$B" "$N"
printf "  Intet på PC'ens disk bliver ændret.\n\n"

trin() { printf '  %s»%s %s' "$B" "$N" "$1"; }
okay() { printf ' %sOK%s\n' "$G" "$N"; }
stop() {
    printf " %sFEJL%s\n\n  %s\n\n  Sluk PC'en med tænd/sluk-knappen.\n" "$R" "$N" "$1"
    while true; do sleep 3600; done
}

# ── 1. USB-nøglen ──────────────────────────────────────────
trin "Finder USB-nøglen…"
USB_PART=''
for _ in 1 2 3 4 5; do
    while read -r navn fstype; do
        case "$fstype" in vfat|exfat) ;; *) continue ;; esac
        if mount -o ro "$navn" "$USB_MNT" 2>/dev/null; then
            if [ -f "$USB_MNT/live/filesystem.squashfs" ]; then
                USB_PART=$navn
                break 2
            fi
            umount "$USB_MNT"
        fi
    done < <(lsblk -lnpo NAME,FSTYPE)
    sleep 1
done
[ -n "$USB_PART" ] || stop "USB-nøglen blev ikke fundet."
umount "$USB_MNT"
okay

# ── 2. PC'ens installerede system ──────────────────────────
trin "Finder Badminton TV på PC'ens disk…"
ROD=''
for _ in 1 2 3 4 5; do
    ROD=$(blkid -L badminton-tv 2>/dev/null || true)
    [ -n "$ROD" ] && break
    sleep 1
done
[ -n "$ROD" ] || stop "PC'en har ikke Badminton TV installeret (ingen disk med navnet badminton-tv)."
# noload: et frosset system er slukket hårdt, og ext4's journal må IKKE
# afspilles — det ville skrive på disken
mount -o ro,noload "$ROD" "$PC" 2>/dev/null || mount -o ro "$ROD" "$PC" 2>/dev/null \
    || stop "PC'ens disk ($ROD) kunne ikke åbnes."
okay

JOURNAL=$PC/var/log/journal
NAVN=$(tr -cd 'A-Za-z0-9._-' < "$PC/etc/hostname" 2>/dev/null)
[ -n "$NAVN" ] || NAVN=ukendt-pc
MAPPE="$NAVN-$(date '+%Y-%m-%d-%H%M')"
UD=$TMP/$MAPPE
mkdir -p "$UD"

# ── 3. Oversigt ────────────────────────────────────────────
trin "Læser PC'ens opstarter…"
jc() { journalctl --directory="$JOURNAL" --no-pager "$@" 2>/dev/null; }

# Endte en opstart med en ordentlig nedlukning? Ellers frøs PC'en, eller
# strømmen blev afbrudt (fx tænd/sluk-knappen holdt inde).
afslutning() {
    # Nyere systemd: "Reached target poweroff.target - System Power Off.";
    # journald slutter altid en ordentlig nedlukning med "Journal stopped"
    if jc -b "$1" -o cat -n 400 | grep -qE 'Journal stopped|System Power Off|System Reboot|System Halt|systemd-shutdown|Powering off|Rebooting'; then
        echo 'lukket ned normalt'
    else
        echo '*** IKKE LUKKET NED — frøs eller mistede strømmen ***'
    fi
}

{
    printf 'Badminton TV — fejllog hentet %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'PC-navn: %s\n' "$NAVN"
    printf 'PC: %s %s (%s), BIOS %s %s\n' \
        "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" "$(cat /sys/class/dmi/id/product_version 2>/dev/null)" \
        "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" "$(cat /sys/class/dmi/id/bios_version 2>/dev/null)" \
        "$(cat /sys/class/dmi/id/bios_date 2>/dev/null)"
    printf 'RAM: %s MB\n' "$(awk '/MemTotal/ { print int($2 / 1024) }' /proc/meminfo)"
    printf 'Installeret version: %s\n' "$(cat "$PC/usr/share/badminton-tv/version" 2>/dev/null || echo ukendt)"
    printf 'USB-nøglens version: %s\n' "$(cat /usr/share/badminton-tv/version 2>/dev/null || echo ukendt)"
    [ -f "$PC/etc/badminton-tv/installeret" ] && { printf '\n-- Installation --\n'; cat "$PC/etc/badminton-tv/installeret"; }

    printf '\n== Opstarter (nyeste nederst) ==\n'
    printf 'Hver linje: nr., start og slut. En opstart der IKKE er lukket ned normalt,\n'
    printf "er den interessante: PC'ens log stopper der, hvor den frøs.\n\n"
    if [ -d "$JOURNAL" ]; then
        jc --list-boots | tail -n "$ANTAL_OPSTARTER" | while read -r nr _id rest; do
            [[ "$nr" =~ ^-?[0-9]+$ ]] || { printf '%s\n' "$nr $_id $rest"; continue; }
            printf '%5s  %s  →  %s\n' "$nr" "$rest" "$(afslutning "$nr")"
        done
    else
        printf "Ingen log fundet på PC'ens disk (/var/log/journal mangler).\n"
    fi

    printf '\n== Disk ==\n'
    df -h "$PC" 2>/dev/null
    printf '\n== Kernenedbrud (pstore) ==\n'
    ls -la "$PC/var/lib/systemd/pstore" 2>/dev/null || printf 'ingen\n'
    # Årsagen står inde i dumpet: panik-linjen og browser-vagtens egne linjer
    # (diskfejlene, den gentog lige før panikken). Hele dumpet ligger i kernenedbrud\.
    # Dumpet ligger i flere dele, så sortér på kernens tidsstempel "[  287.37]".
    grep -rhsE 'Kernel panic - not syncing|browservagt:' "$PC/var/lib/systemd/pstore" 2>/dev/null \
        | sort -t '[' -k2,2n | awk '!set[$0]++' | head -60 | sed 's/^/  /'
    printf '\n== Hardware ==\n'
    lspci -nn 2>/dev/null | grep -iE 'vga|display|network|ethernet|wireless'
} > "$UD/OVERSIGT.txt"
okay

# ── 4. Hver opstart ────────────────────────────────────────
trin "Kopierer loggen fra de seneste $ANTAL_OPSTARTER opstarter…"
if [ -d "$JOURNAL" ]; then
    # --list-boots: "IDX BOOT-ID UGEDAG DATO TID ZONE …" (evt. med overskrift)
    jc --list-boots | tail -n "$ANTAL_OPSTARTER" | awk '$1 ~ /^-?[0-9]+$/ { print $1, $4 }' | while read -r nr start; do
        fil=$(printf '%s/opstart-%03d-%s.txt' "$UD" "$(( -nr ))" "${start:-ukendt}")
        {
            printf 'Opstart %s: %s\n\n' "$nr" "$(afslutning "$nr")"
            printf '== Advarsler og fejl (alle) ==\n'
            jc -b "$nr" -p warning -o short-iso
            printf '\n== Kernen (alle beskeder) ==\n'
            jc -b "$nr" -k -o short-iso
            printf '\n== De sidste 600 linjer før opstarten sluttede ==\n'
            printf "(frøs PC'en, er det her, sporet er)\n"
            jc -b "$nr" -o short-iso -n 600
        } > "$fil"
    done
fi
okay

# ── 5. Kernenedbrud og konfiguration ───────────────────────
if [ -d "$PC/var/lib/systemd/pstore" ] && [ -n "$(ls -A "$PC/var/lib/systemd/pstore" 2>/dev/null)" ]; then
    cp -r "$PC/var/lib/systemd/pstore" "$UD/kernenedbrud" 2>/dev/null
fi
if [ -f "$PC/etc/badminton-tv/kiosk.conf" ]; then
    grep -v '^[[:space:]]*WIFI_KODE' "$PC/etc/badminton-tv/kiosk.conf" > "$UD/kiosk.conf.txt"
    printf '# WIFI_KODE er fjernet\n' >> "$UD/kiosk.conf.txt"
fi
umount "$PC" 2>/dev/null

# ── 6. Ned på USB-nøglen ───────────────────────────────────
trin "Gemmer på USB-nøglen…"
mount -o rw "$USB_PART" "$USB_MNT" 2>/dev/null || stop "USB-nøglen kunne ikke skrives på."
mkdir -p "$USB_MNT/fejllog/$MAPPE"
# CRLF, så filerne ser rigtige ud i Windows' Notesblok
for f in "$UD"/*.txt; do
    sed 's/$/\r/' "$f" > "$USB_MNT/fejllog/$MAPPE/$(basename "$f")"
done
[ -d "$UD/kernenedbrud" ] && cp -r "$UD/kernenedbrud" "$USB_MNT/fejllog/$MAPPE/"
sync
umount "$USB_MNT"
okay

# ── Færdig ─────────────────────────────────────────────────
uren=$(grep -c 'IKKE LUKKET NED' "$UD/OVERSIGT.txt" || true)
printf '\n  %sFærdig.%s Fejlloggen ligger på USB-nøglen i mappen:\n\n' "$G" "$N"
printf '    %sfejllog\\%s%s\n\n' "$F" "$MAPPE" "$N"
if [ "${uren:-0}" -gt 0 ]; then
    printf '  %s%s opstart(er) endte uden normal nedlukning%s (frøs eller mistede strømmen).\n\n' "$Y" "$uren" "$N"
fi
printf "  Tag USB-nøglen ud, og sluk PC'en med tænd/sluk-knappen.\n"
printf '  Starter den igen uden nøglen, kører den som TV som før.\n'
while true; do sleep 3600; done
