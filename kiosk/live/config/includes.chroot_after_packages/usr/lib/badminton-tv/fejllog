#!/usr/bin/python3
"""Fejllog fra admin: sender PC'ens log til serveren, når admin beder om den.

Før skulle man starte PC'en fra USB-nøglen med "Hent fejllog" og tage loggen
med hjem. Nu kan klubbens admin trykke "Hent fejllog" under Adgangslinks:

  fejllog spoerg   hvert 2. minut (badminton-tv-fejllog.timer): har admin bedt
                   om loggen? Så samles den (fejllog.sh — det samme som på
                   USB-nøglen), pakkes som zip og sendes til serveren, hvor
                   admin kan hente den.
  fejllog saml MAPPE
                   saml loggen i MAPPE uden at sende den (til fejlsøgning)

PC'en skal være tændt og have net — men loggen ligger på disken på tværs af
genstarter, så en kørsel, der frøs, kommer med, når PC'en er startet igen.
På en Raspberry Pi ligger loggen kun i RAM: kun den nuværende kørsel.

Adgangen er adgangslinkets token (X-Adgangslink, fra TV_URL i kiosk.conf),
som rapporten. Kodens egen tekst og WiFi-koden står aldrig i loggen
(fejllog_rens i fejllog.sh).

Kun Pythons standardbibliotek.
"""

import importlib.machinery
import importlib.util
import io
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile

BT_LIB = os.environ.get('BT_LIB', '/usr/lib/badminton-tv')
ARB = os.environ.get('BT_FEJLLOG_ARB', '/run/badminton-tv/fejllog-admin')
# Serveren tager højst 10 MB. Bliver zip'en større (en PC, der har skrevet
# advarsler i ring), tages færre opstarter med.
MAKS_BYTES = int(os.environ.get('BT_FEJLLOG_MAKS', str(9 * 1024 * 1024)))
ANTAL_FORSOEG = (15, 5, 2)
TIMEOUT = 20
SEND_TIMEOUT = 120


def log(tekst):
    print(f'[fejllog] {tekst}', flush=True)


def _rapport():
    """Rapportens hjælpere (kiosk_env, adgangslink, laes_tekst) — én kilde."""
    sti = os.path.join(BT_LIB, 'rapport')
    loader = importlib.machinery.SourceFileLoader('bt_rapport', sti)
    spec = importlib.util.spec_from_loader('bt_rapport', loader)
    modul = importlib.util.module_from_spec(spec)
    loader.exec_module(modul)
    return modul


R = _rapport()


def post(url, token, data, content_type='application/json', timeout=TIMEOUT):
    req = urllib.request.Request(url, data=data, method='POST', headers={
        'Content-Type': content_type, 'X-Adgangslink': token,
        'User-Agent': 'badminton-tv-fejllog'})
    with urllib.request.urlopen(req, timeout=timeout) as svar:
        return svar.read()


def saml(mappe, antal):
    """Samler loggen i mappe med fejllog.sh (det kørende system)."""
    navn = R.kiosk_env()[1] or R.laes_tekst('/etc/hostname') or 'ukendt-pc'
    kode = subprocess.run(
        ['bash', '-c', '. "$1/fejllog.sh"; FL_ANTAL=$2 fejllog_saml "$3" "$4" "$5"', 'bash',
         BT_LIB, str(antal), mappe, 'det kørende system (hentet fra admin)', navn],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, errors='replace',
        timeout=600).returncode
    if not os.path.exists(os.path.join(mappe, 'OVERSIGT.txt')):
        raise RuntimeError(f'loggen kunne ikke samles (kode {kode})')


def pak(mappe):
    """Mappen som zip i hukommelsen. .txt med CRLF, så de ser rigtige ud i Notesblok."""
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, 'w', zipfile.ZIP_DEFLATED, compresslevel=9) as z:
        for rod, _, filer in os.walk(mappe):
            for f in sorted(filer):
                sti = os.path.join(rod, f)
                navn = os.path.relpath(sti, mappe).replace(os.sep, '/')
                with open(sti, 'rb') as fh:
                    data = fh.read()
                if f.endswith('.txt'):
                    data = data.replace(b'\r\n', b'\n').replace(b'\n', b'\r\n')
                z.writestr(navn, data)
    return buf.getvalue()


def lav_zip():
    """Zip'en med så mange opstarter, som der er plads til (bytes)."""
    os.makedirs(ARB, exist_ok=True)
    data = b''
    for antal in ANTAL_FORSOEG:
        mappe = tempfile.mkdtemp(dir=ARB)
        try:
            saml(mappe, antal)
            data = pak(mappe)
        finally:
            shutil.rmtree(mappe, ignore_errors=True)
        if len(data) <= MAKS_BYTES:
            return data, antal
        log(f'{len(data) // 1024} KB med {antal} opstarter er for meget — prøver med færre')
    raise RuntimeError(f'loggen fylder {len(data) // 1024} KB — mere, end serveren tager')


def spoerg():
    tv_url, navn = R.kiosk_env()
    server, token = R.adgangslink(tv_url)
    if not server or not navn:
        return 0
    version = R.laes_tekst(R.VERSION_FIL)
    url = os.environ.get('BT_FEJLLOG_URL') or f'{server}/api/screens/pc-fejllog'

    def meld(status='', tekst=''):
        data = json.dumps({'navn': navn, 'kioskVersion': version, 'status': status, 'tekst': tekst[:300]}).encode()
        return json.loads(post(f'{url}/spoerg', token, data) or b'{}')

    try:
        svar = meld()
    except (urllib.error.URLError, OSError, ValueError):
        return 0                       # intet net — spørger igen om 2 minutter
    if not svar.get('hent'):
        return 0

    log('admin har bedt om fejlloggen')
    try:
        meld('samler', 'Samler loggen …')
    except (urllib.error.URLError, OSError, ValueError):
        pass
    start = time.monotonic()
    try:
        data, antal = lav_zip()
        q = urllib.parse.urlencode({'navn': navn, 'kioskVersion': version, 'opstarter': antal})
        post(f'{url}?{q}', token, data, 'application/zip', timeout=SEND_TIMEOUT)
    except urllib.error.HTTPError as e:
        tekst = f'serveren afviste loggen ({e.code})'
        log(tekst)
        try:
            meld('fejl', tekst)
        except (urllib.error.URLError, OSError, ValueError):
            pass
        return 1
    except (urllib.error.URLError, OSError) as e:
        log(f'kunne ikke sende loggen ({getattr(e, "reason", e)}) — admin kan trykke igen')
        return 1
    except (RuntimeError, subprocess.SubprocessError) as e:
        log(f'fejl: {e}')
        try:
            meld('fejl', str(e))
        except (urllib.error.URLError, OSError, ValueError):
            pass
        return 1
    log(f'fejlloggen er sendt ({len(data) // 1024} KB, {antal} opstarter, {time.monotonic() - start:.0f} s)')
    return 0


def main(argv):
    kommando = argv[1] if len(argv) > 1 else ''
    if kommando == 'spoerg':
        return spoerg()
    if kommando == 'saml' and len(argv) >= 3:
        os.makedirs(argv[2], exist_ok=True)
        saml(argv[2], ANTAL_FORSOEG[0])
        print(argv[2])
        return 0
    print(__doc__)
    return 2


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv))
    except Exception as e:          # noqa: BLE001 — timeren prøver igen om 2 minutter
        log(f'fejl: {e}')
        sys.exit(0)
