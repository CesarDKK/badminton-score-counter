#!/bin/bash
# Automatisk opdatering af Badminton TV — på PC'en og på Raspberry Pi'en.
#
# Disken (SD-kortet) har to systemer, A og B (se rod.sh). Det ene kører, det
# andet er ledigt. En ny version skrives til det ledige, mens TV'et kører
# videre, og prøves ved næste opstart. Kommer TV-siden frem og kører i 5
# minutter, bliver den nye version det aktive system; ellers starter det gamle
# igen.
#   PC:  GRUB på EFI-partitionen vælger system (grub-esp.cfg + badminton-tv.env).
#   Pi:  config.txt vælger system med os_prefix. Pi'en prøver det nye med en
#        tryboot-genstart lige efter opstarten — firmwaren glemmer tryboot igen,
#        så næste opstart er altid det gamle, medmindre det nye er godkendt.
#
#   opdatering tjek       hent og klargør en ny version, hvis der er en
#                         (badminton-tv-opdatering.timer, hver anden time)
#   opdatering proev      Pi: genstart med tryboot, hvis en ny version venter
#                         (badminton-tv-opdatering-proev.service, ved opstart)
#   opdatering bekraeft   i et nyt system på prøve: gør det til det aktive, når
#                         TV-siden har kørt i 5 minutter — eller genstart til
#                         det gamle, hvis den ikke er kommet efter 20 minutter
#   opdatering status     vis tilstanden
#   opdatering spoerg     har admin bedt om nyeste version nu (Adgangslinks →
#                         "Installér nyeste nu")? Så hent den med det samme og
#                         genstart, når den er klar
#                         (badminton-tv-opdatering-spoerg.timer, hvert 2. minut)
#
# Versionerne hentes fra GitHub-udgivelserne (tags tv-usb-v*): manifestet
# (opdatering.json / opdatering-pi.json), signeret med Badminton TV's nøgle
# (opdatering.pub), og rod-filsystemet, hvis SHA256 står i manifestet. Uden
# gyldig signatur sker der intet. Der nedgraderes aldrig.
#
# OPDATERING i kiosk.conf:
#   auto    hent, når udgivelsen er vent_timer gammel (står i manifestet,
#           normalt 24 timer)
#   foerst  hent med det samme. Én skærm (fx oversigten) går forrest, så en
#           fejl kan opdages, før de andre følger efter — markér udgivelsen som
#           "pre-release" på GitHub, så stopper udrulningen.
#   fra     aldrig

set -Eeuo pipefail
BT_LIB=${BT_LIB:-/usr/lib/badminton-tv}
. "$BT_LIB/conf.sh"
. "$BT_LIB/rod.sh"

KILDE=https://github.com/CesarDKK/badminton-score-counter/releases
NOEGLE=${BT_NOEGLE:-/usr/share/badminton-tv/opdatering.pub}
BTENV=/boot/efi/EFI/debian/badminton-tv.env
KORT=${BT_KORT:-/boot/kort}
ARB=/run/badminton-tv/opdatering
KIOSK_ENV=${BT_KIOSK_ENV:-/run/badminton-tv/kiosk.env}
SUND_SEK=300        # så længe skal TV-siden have kørt, før et nyt system godkendes
FRIST_SEK=1200      # … og senest så længe efter opstarten
MAKS_FORSOEG=3      # forsøg pr. version, før den opgives
HASTIGHED_DAG=1M    # curl --limit-rate for en auto-hentning om dagen (8 Mbit/s)
# Kun til test (kiosk/test/opdatering-vm.sh): anden KILDE og kortere tider.
if [ -f /etc/badminton-tv/opdatering.env ]; then
    . /etc/badminton-tv/opdatering.env
fi

if [ -n "${BT_PLATFORM:-}" ]; then
    PLATFORM=$BT_PLATFORM
elif tr -d '\0' 2>/dev/null < /proc/device-tree/model | grep -q 'Raspberry Pi'; then   # (2>/dev/null først: PC'en har ingen device tree)
    PLATFORM=pi
else
    PLATFORM=pc
fi
if [ "$PLATFORM" = pi ]; then
    MANIFEST=opdatering-pi.json
    ROD_NAVN=badminton-tv-pi-rod
    PI_ENV=$KORT/badminton-tv-opdatering.txt
else
    MANIFEST=opdatering.json
    ROD_NAVN=badminton-tv-rod
fi

cmdline() { tr ' ' '\n' < /proc/cmdline | sed -n "s/^$1=//p" | tail -1; }
SLOT=$(cmdline badminton.slot)
VERSION_NU=$(cat /usr/share/badminton-tv/version 2>/dev/null || echo ukendt)

# Tilstanden (aktiv, proev, proev_version, proev_antal …): på PC'en i GRUB's
# miljøfil, på Pi'en i en tekstfil på SD-kortets FAT-partition.
#
# Pi'ens fil findes ikke på et nyt SD-kort, før den første opdatering skriver
# den (nr. 62). Før fejlede både læsning (sed på en manglende fil) og
# skrivning (grep uden linjer) under set -e/pipefail — så døde scriptet, og en
# Pi kunne aldrig opdatere sig selv.
env_hent() {
    if [ "$PLATFORM" = pi ]; then
        [ -f "$PI_ENV" ] || return 0
        sed -n "s/^$1=//p" "$PI_ENV" | tail -1
    else
        grub-editenv "$BTENV" list 2>/dev/null | sed -n "s/^$1=//p"
    fi
}
pi_env_skriv() { # awk-program, der får filen ind og skriver den nye
    {
        printf '# Badminton TV: automatisk opdatering. Rør ikke filen.\n'
        { grep -v '^#' "$PI_ENV" 2>/dev/null || true; } | awk "$1"
    } > "$PI_ENV.ny"
    sync
    mv "$PI_ENV.ny" "$PI_ENV"
    sync
}
env_saet() { # nøgle=værdi …
    if [ "$PLATFORM" = pi ]; then
        local kv prog='1'
        for kv in "$@"; do prog="$prog && !/^${kv%%=*}=/"; done
        pi_env_skriv "$prog { print } END { $(for kv in "$@"; do printf 'print "%s"; ' "$kv"; done) }"
    else
        grub-editenv "$BTENV" set "$@"
    fi
}
env_slet() { # nøgle …
    if [ "$PLATFORM" = pi ]; then
        local k prog='1'
        for k in "$@"; do prog="$prog && !/^$k=/"; done
        pi_env_skriv "$prog { print }"
    else
        grub-editenv "$BTENV" unset "$@"
    fi
}
aktiv() { local a; a=$(env_hent aktiv); echo "${a:-a}"; }

# Kører et nyt system på prøve, som ikke er godkendt endnu? Det er det, når
# det ikke er det aktive. (Ikke badminton.forsoeg fra GRUB: den står på
# kernelinjen resten af opstarten, også efter godkendelsen — så tjekkede
# PC'en ikke for nye versioner før næste opstart. Set i VM-testen.)
paa_proeve() {
    [ -n "$SLOT" ] && [ "$SLOT" != "$(aktiv)" ]
}

# er_nyere A B — er B en nyere version end A?
er_nyere() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]
}

# beslut KØRENDE NY UDGIVET VENT_TIMER TILSTAND NU KLAR ANTAL [NAT]
#   KLAR:  versionen der allerede venter på næste opstart (tom: ingen)
#   ANTAL: hvor mange gange NY er gjort klar før
#   NAT:   1, når PC'en er ved at slukke (sluk, kl. SLUK_KL)
# Udskriver: fra | nyeste | venter <sekunder> | klar | opgivet | nat | hent
#
# OPDATERING=auto henter ved slukningen (nr. 102): systemet er ca. 700 MB, og
# alle hallens auto-skærme passerer ventetiden på samme tid — før hentede de
# alle samtidig midt i åbningstiden. Kommer PC'en ikke til at slukke af sig
# selv (slukkes på knappen hver aften), hentes den alligevel, når den har
# ventet NAT_FRIST_T timer mere — langsomt (HASTIGHED_DAG). "foerst" og
# "Installér nyeste nu" (BT_NU) henter stadig med det samme.
NAT_FRIST_T=48
beslut() {
    local koer=$1 ny=$2 udgivet=$3 vent=$4 tilstand=$5 nu=$6 klar=$7 antal=$8 nat=${9:-}
    if [ "$tilstand" = fra ]; then echo fra; return; fi
    if ! er_nyere "$koer" "$ny"; then echo nyeste; return; fi
    local frem=$((udgivet + vent * 3600 - nu))
    if [ "$tilstand" != foerst ]; then
        if [ "$frem" -gt 0 ]; then echo "venter $frem"; return; fi
    fi
    if [ "$klar" = "$ny" ]; then echo klar; return; fi
    if [ "${antal:-0}" -ge "$MAKS_FORSOEG" ]; then echo opgivet; return; fi
    if [ "$tilstand" = auto ] && [ "$nat" != 1 ] && [ "$frem" -gt $((-NAT_FRIST_T * 3600)) ]; then
        echo nat; return
    fi
    echo hent
}

# laes_manifest FIL — sætter M_VERSION, M_UDGIVET, M_VENT, M_FIL, M_SHA256 og
# M_BYTES. Fejler, hvis noget ser forkert ud (filnavnet bruges i en URL og en
# sti, så det skal være helt almindeligt).
laes_manifest() {
    local felter
    felter=$(jq -er '[.version, .udgivet, (.vent_timer // 24), .rod.fil, .rod.sha256, .rod.bytes]
                     | map(tostring) | join("\t")' "$1" 2>/dev/null) || return 1
    IFS=$'\t' read -r M_VERSION M_UDGIVET M_VENT M_FIL M_SHA256 M_BYTES <<<"$felter"
    # Også en ekstra udgivelse samme dag (tv-usb-v2026.10.29.1) — før blev de
    # afvist, så PC'erne aldrig fik dem
    [[ "$M_VERSION" =~ ^[0-9]{4}\.[0-9]{1,2}\.[0-9]{1,3}(\.[0-9]{1,3})?$ ]] &&
    [[ "$M_UDGIVET" =~ ^[0-9]{9,11}$ ]] &&
    [[ "$M_VENT" =~ ^[0-9]{1,3}$ ]] &&
    [ "$M_FIL" = "$ROD_NAVN-$M_VERSION.squashfs" ] &&
    [[ "$M_SHA256" =~ ^[0-9a-f]{64}$ ]] &&
    [[ "$M_BYTES" =~ ^[0-9]{6,11}$ ]]
}

# signatur_ok FIL SIG — ed25519-signatur fra Badminton TV's nøgle?
signatur_ok() {
    openssl pkeyutl -verify -pubin -inkey "$NOEGLE" -rawin -in "$1" -sigfile "$2" >/dev/null 2>&1
}

hent() { # URL FIL [curl-flag…]
    local url=$1 fil=$2; shift 2
    curl -fsSL --proto '=https,http' --connect-timeout 30 -o "$fil" "$@" "$url"
}

# Genstarten er planlagt — rapporten (/usr/lib/badminton-tv/rapport) skal ikke
# melde den som en hændelse
planlagt_genstart() {
    local fil=${BT_NEDLUKNING:-/run/badminton-tv/nedlukning}
    { mkdir -p "${fil%/*}" && echo opdatering > "$fil"; } 2>/dev/null || true
}

# Med BT_NU=1 (spoerg: admin har bedt om nyeste version nu) skriver tjek, hvordan
# det endte, i $ARB/udfald: "klar <version>" | nyeste | fra | kan-ikke. Ingen
# fil: prøv igen senere (uret, nettet, en anden hentning i gang) — eller, med
# fejlkode, en fejl.
udfald() {
    [ -z "${BT_NU:-}" ] || printf '%s\n' "$*" > "$ARB/udfald"
}

# ── tjek ───────────────────────────────────────────────────
tjek() {
    if [ -z "$SLOT" ]; then
        if [ "$PLATFORM" = pi ]; then
            echo "SD-kortet har det gamle layout med ét system — skriv et nyt billede på kortet for at få automatisk opdatering."
        else
            echo "PC'en har det gamle disklayout med ét system — installér den forfra fra USB-nøglen for at få automatisk opdatering."
        fi
        udfald kan-ikke
        return 0
    fi
    if paa_proeve; then
        echo "System $SLOT kører på prøve og er ikke godkendt endnu — tjekker ikke for opdateringer."
        return 0
    fi

    local conf
    if conf=$(bt_find_conf); then
        bt_read_conf "$conf"
    else
        BT_OPDATERING=auto
    fi
    if [ "$BT_OPDATERING" = fra ]; then
        echo "Automatisk opdatering er slået fra (OPDATERING=fra i kiosk.conf)."
        udfald fra
        return 0
    fi
    # Bedt om det fra admin: med det samme, som "foerst" — og også en version,
    # der er opgivet efter 3 forsøg, prøves én gang til
    local tilstand=$BT_OPDATERING
    [ -z "${BT_NU:-}" ] || tilstand=foerst
    # Uret skal passe: udgivelsestidspunktet sammenlignes med det, og HTTPS
    # afviser certifikaterne med et forkert ur.
    if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != yes ]; then
        echo "Uret er ikke sat fra internettet endnu — prøver igen senere."
        return 0
    fi

    mkdir -p "$ARB"
    rm -f "$ARB/manifest.json" "$ARB/manifest.json.sig"
    if ! hent "$KILDE/latest/download/$MANIFEST" "$ARB/manifest.json" --max-time 60 \
       || ! hent "$KILDE/latest/download/$MANIFEST.sig" "$ARB/manifest.json.sig" --max-time 60; then
        echo "Kunne ikke hente opdateringsmanifestet ($MANIFEST) fra $KILDE — prøver igen senere."
        return 0
    fi
    if ! signatur_ok "$ARB/manifest.json" "$ARB/manifest.json.sig"; then
        echo "FEJL: Opdateringsmanifestets signatur passer ikke — det bliver ikke brugt."
        return 1
    fi
    if ! laes_manifest "$ARB/manifest.json"; then
        echo "FEJL: Opdateringsmanifestet kan ikke læses: $(head -c 500 "$ARB/manifest.json")"
        return 1
    fi

    local proev pv antal=0 klar='' svar
    proev=$(env_hent proev)
    pv=$(env_hent proev_version)
    # "Stop udrulningen" (udgivelsen markeret som pre-release, nr. 66): står en
    # version klar til næste opstart, som serveren ikke længere tilbyder (den
    # er nyere end den nyeste udgivne), kasseres den — før blev den startet
    # alligevel. Kommer udgivelsen tilbage, hentes den forfra.
    if [ -n "$proev" ] && [ -n "$pv" ] && er_nyere "$M_VERSION" "$pv"; then
        echo "Version $pv er ikke længere udgivet (den nyeste er $M_VERSION) — den startes ikke."
        env_slet proev proev_version proev_antal
        proev='' pv=''
    fi
    if [ "$pv" = "$M_VERSION" ]; then
        antal=$(env_hent proev_antal)
        [ -n "$proev" ] && klar=$pv
    fi
    [ -z "${BT_NU:-}" ] || antal=0
    # Slukker PC'en aldrig selv (SLUK_KL=aldrig), er der ingen slukning at vente på
    local nat=${BT_NAT:-}
    [ "${BT_SLUK_KL:-23:59}" != aldrig ] || nat=1
    svar=$(beslut "$VERSION_NU" "$M_VERSION" "$M_UDGIVET" "$M_VENT" "$tilstand" "$(date +%s)" "$klar" "${antal:-0}" "$nat")
    case "$svar" in
        nyeste)  echo "Kører den nyeste version ($VERSION_NU)."; udfald nyeste ;;
        venter*) echo "Version $M_VERSION er udgivet. Henter den om ca. $(( (${svar#venter } + 3599) / 3600 )) time(r) (OPDATERING=auto)." ;;
        klar)    echo "Version $M_VERSION er klar og startes ved næste opstart."; udfald klar "$M_VERSION" ;;
        opgivet) echo "Version $M_VERSION er prøvet $antal gange uden at virke — venter på en nyere version." ;;
        nat)     echo "Version $M_VERSION hentes ved den automatiske slukning (kl. ${BT_SLUK_KL:-23:59}), ikke i åbningstiden (OPDATERING=auto)." ;;
        hent)
            # Om dagen (auto, der aldrig nåede en slukning): langsomt, så
            # hallens net ikke mærker det
            HASTIGHED=''
            [ "$tilstand" != auto ] || [ "${BT_NAT:-}" = 1 ] || HASTIGHED=$HASTIGHED_DAG
            # (ikke "klargoer && …": så gjaldt set -e ikke inde i klargoer)
            klargoer
            if [ "$(env_hent proev_version)" = "$M_VERSION" ] && [ -n "$(env_hent proev)" ]; then
                udfald klar "$M_VERSION"
            else
                udfald kan-ikke   # SD-kortet er for lille
            fi ;;
    esac
}

# ── Det ledige system ──────────────────────────────────────
# Udskriver enheden for system $1 — på Pi'en oprettes partitionen, første
# gang der skal bruges et system B. Status 2: SD-kortet er for lille.
ledigt_system() {
    if [ "$PLATFORM" != pi ]; then
        blkid -L "badminton-tv-$1"
        return
    fi
    local dev
    dev=/dev/disk/by-partuuid/$DISKID-$(bt_pi_nr "$1")
    if [ -e "$dev" ]; then
        readlink -f "$dev"
        return
    fi
    # Partition 3 lægges efter roden (2) med samme størrelse.
    local rod disk start str i
    rod=$(readlink -f "/dev/disk/by-partuuid/$DISKID-02")
    disk=/dev/$(lsblk -no PKNAME "$rod")
    start=$(cat "/sys/class/block/$(basename "$rod")/start")
    str=$(cat "/sys/class/block/$(basename "$rod")/size")
    i=$(( (start + str + 8191) / 8192 * 8192 ))
    if [ $((i + str)) -gt "$(cat "/sys/block/$(basename "$disk")/size")" ]; then
        return 2
    fi
    echo "Opretter plads til system B på SD-kortet ($((str / 2048)) MB) …" >&2
    printf 'start=%s, size=%s, type=83\n' "$i" "$str" | sfdisk -q --append --no-reread "$disk" >&2
    partx -a -n 3 "$disk" >&2 2>/dev/null || true
    udevadm settle
    for _ in $(seq 1 20); do
        [ -e "$dev" ] && break
        sleep 0.5
    done
    readlink -f "$dev"
}

# Holder noget stadig fast i partitionen? Samme spørgsmål, mkfs selv stiller
# (åbn med O_EXCL → EBUSY): et filsystem, der er monteret — også et, der blev
# afmonteret "dovent" (umount -l) i et tidligere forsøg og ikke længere ses i
# findmnt, men lever, til ingen bruger det — eller som kernen bruger.
i_brug() { # enhed
    python3 - "$1" <<'EOF' 2>/dev/null
import errno, os, sys
try:
    os.close(os.open(sys.argv[1], os.O_RDONLY | os.O_EXCL))
except OSError as e:
    sys.exit(3 if e.errno == errno.EBUSY else 0)
EOF
    [ $? = 3 ]
}

# Fejlteksten til admin ud fra loggen (LOG). Den første FEJL-linje — er det
# fejlfælden ("FEJL: linje N: kommando (kode K) …"), står kommandoens egen
# besked (fx mkfs.ext4: "… is apparently in use by the system") på linjen
# før, og den sættes forrest. Ellers så admin kun linjenummeret. Uden en
# FEJL-linje: den sidste linje. Højst 300 tegn (serverens loft).
fejltekst() { # log
    local linje nr foer
    if ! linje=$(grep -m1 -n '^FEJL' "$1"); then
        grep -v '^[[:space:]]*$' "$1" | tail -1 | cut -c1-300 || true
        return 0
    fi
    nr=${linje%%:*}
    linje=${linje#*:}
    if [[ "$linje" == "FEJL: linje "* ]]; then
        linje=${linje% — prøver igen næste gang.}
        foer=$(head -n "$((nr - 1))" "$1" | grep -v '^[[:space:]]*$' | tail -1 || true)
        [ -n "$foer" ] && linje="FEJL: $foer (${linje#FEJL: })"
    fi
    printf '%s\n' "$linje" | cut -c1-300
}

# Skriver M_VERSION til det ledige system og sætter det til at blive prøvet.
klargoer() {
    local andet dev status=0
    if [ "$SLOT" = a ]; then andet=b; else andet=a; fi
    if [ "$PLATFORM" = pi ]; then
        DISKID=$(cmdline root | sed -n 's/^PARTUUID=\(.*\)-0[0-9]$/\1/p')
        [ -n "$DISKID" ] || { echo "FEJL: Kan ikke finde SD-kortets disk-id i kernelinjen."; return 1; }
    fi
    dev=$(ledigt_system "$andet") || status=$?
    if [ "$status" = 2 ]; then
        echo "SD-kortet er for lille til automatisk opdatering — brug et kort på mindst 16 GB."
        return 0
    fi
    if [ "$status" != 0 ] || [ ! -b "$dev" ]; then
        echo "FEJL: System $andet findes ikke på disken."
        return 1
    fi
    if findmnt -rno TARGET "$dev" >/dev/null; then
        echo "FEJL: System $andet ($dev) er i brug."
        return 1
    fi
    if i_brug "$dev"; then
        echo "FEJL: System $andet ($dev) er stadig i brug efter et tidligere forsøg — genstart PC'en, og prøv igen."
        return 1
    fi
    NY=$ARB/system-$andet
    KILDE_MNT=$ARB/kilde
    mkdir -p "$NY" "$KILDE_MNT"
    trap 'oprydning' EXIT

    # Står versionen allerede klar fra et tidligere forsøg (der ikke blev
    # godkendt, fx fordi nettet var nede), skal den ikke hentes igen.
    if mount -o ro "$dev" "$NY" 2>/dev/null; then
        local fra_foer
        fra_foer=$(cat "$NY/.badminton-tv-klar" 2>/dev/null || true)
        umount "$NY"
        if [ "$fra_foer" = "$M_VERSION" ] \
           && { [ "$PLATFORM" != pi ] || [ -s "$KORT/$andet/cmdline.txt" ]; }; then
            echo "Version $M_VERSION ligger allerede på system $andet fra et tidligere forsøg."
            saet_proev "$andet"
            return 0
        fi
    fi

    echo "Henter version $M_VERSION ($((M_BYTES / 1000000)) MB) til system $andet ($dev) …"
    # Lige efter afmonteringen ovenfor kan udev stadig have fat i partitionen —
    # så venter vi et øjeblik og prøver én gang til (fejlen meldes med mkfs'
    # egen besked, se fejltekst)
    if ! mkfs.ext4 -F -q -L "badminton-tv-$andet" "$dev"; then
        echo "Formateringen af system $andet fejlede — prøver igen om lidt …"
        udevadm settle 2>/dev/null || true
        sleep 3
        mkfs.ext4 -F -q -L "badminton-tv-$andet" "$dev"
    fi
    mount "$dev" "$NY"
    local sq=$NY/.badminton-tv-hentning.squashfs
    # Giver op, hvis der ikke er kommet 10 KB/s i 2 minutter — prøver igen
    # næste gang (hele forløbet starter forfra, med et tomt filsystem).
    hent "$KILDE/download/tv-usb-v$M_VERSION/$M_FIL" "$sq" \
        --retry 3 --retry-delay 30 --speed-limit 10000 --speed-time 120 \
        ${HASTIGHED:+--limit-rate "$HASTIGHED"}
    if [ "$(stat -c %s "$sq")" != "$M_BYTES" ] \
       || ! printf '%s  %s\n' "$M_SHA256" "$sq" | sha256sum -c --quiet; then
        echo "FEJL: Den hentede fil passer ikke med manifestet (størrelse eller SHA256)."
        return 1
    fi

    echo "Kopierer systemet …"
    mount -o loop,ro "$sq" "$KILDE_MNT"
    rsync -aHAXx --numeric-ids "$KILDE_MNT/" "$NY/"
    umount "$KILDE_MNT"
    rm -f "$sq"

    echo "Overfører indstillingerne …"
    # kiosk.conf (med WiFi-koden), installationsoplysninger og evt.
    # testindstillinger. (På Pi'en ligger kiosk.conf på FAT-partitionen.)
    if [ -d /etc/badminton-tv ]; then
        mkdir -p "$NY/etc/badminton-tv"
        cp -a /etc/badminton-tv/. "$NY/etc/badminton-tv/"
        printf 'opdateret=%s\nversion=%s\n' "$(date --iso-8601=seconds)" "$M_VERSION" >> "$NY/etc/badminton-tv/installeret"
    fi
    cp /etc/hostname "$NY/etc/hostname"
    # Samme maskine-id som før (bruges bl.a. af DHCP), så den beholder sin IP
    rm -f "$NY/var/lib/dbus/machine-id"
    cp /etc/machine-id "$NY/etc/machine-id"

    echo "Gør systemet klar til at starte …"
    if [ "$PLATFORM" = pi ]; then
        klargoer_pi_opstart "$andet"
        bt_pi_fstab "$NY" "$DISKID" "$andet"
        bt_pi_kan_starte "$KORT" "$andet" "$DISKID" "$M_VERSION" "$NY"
    else
        bt_rod_fstab "$NY" "$(blkid -s UUID -o value "$dev")" "$(findmnt -no UUID /boot/efi)"
        bt_rod_monter "$NY"
        bt_rod_fjern_live "$NY"
        bt_rod_laas_grub "$NY"
        bt_rod_afmonter "$NY"
        bt_rod_kan_starte "$NY" "$M_VERSION"
    fi

    printf '%s\n' "$M_VERSION" > "$NY/.badminton-tv-klar"
    sync
    umount "$NY"
    saet_proev "$andet"
}

# Pi: systemets kerne, initramfs, device trees og cmdline.txt ligger i
# squashfs'ens /boot/firmware og skal over i sin mappe på FAT-partitionen.
klargoer_pi_opstart() { # slot
    local dir=$KORT/$1
    rm -rf "$dir.ny"
    mkdir -p "$dir.ny"
    # FAT kan ikke have ejer og rettigheder
    cp -r --no-preserve=all "$NY/boot/firmware/." "$dir.ny/"
    find "$NY/boot/firmware" -mindepth 1 -delete
    sed -i -e "s/root=PARTUUID=[^ ]*/root=PARTUUID=$DISKID-$(bt_pi_nr "$1")/" \
           -e "s/badminton\.slot=[a-z]*/badminton.slot=$1/" "$dir.ny/cmdline.txt"
    sync
    rm -rf "$dir"
    mv "$dir.ny" "$dir"
    sync
}

oprydning() {
    if [ -n "${NY:-}" ] && mountpoint -q "$NY"; then
        bt_rod_afmonter "$NY" 2>/dev/null || true
        if ! umount -R "$NY" 2>/dev/null; then
            # Noget har stadig fat i det — afmonteres "dovent", når det slipper.
            # Indtil da kan næste forsøg ikke formatere det (se i_brug).
            echo "System-mappen $NY kunne ikke afmonteres helt (noget bruger den stadig)."
            umount -Rl "$NY" 2>/dev/null || true
        fi
    fi
    if [ -n "${KILDE_MNT:-}" ] && mountpoint -q "$KILDE_MNT"; then
        umount "$KILDE_MNT" 2>/dev/null || true
    fi
}

saet_proev() { # slot
    local antal=0
    if [ "$(env_hent proev_version)" = "$M_VERSION" ]; then
        antal=$(env_hent proev_antal)
    fi
    antal=$((${antal:-0} + 1))
    env_saet proev="$1" proev_version="$M_VERSION" proev_antal="$antal"
    echo "Version $M_VERSION er klar på system $1 og startes ved næste opstart (forsøg $antal af $MAKS_FORSOEG)."
}

# ── proev (Pi) ─────────────────────────────────────────────
# Ved opstart: venter en ny version, så genstart med tryboot ind i den. proev
# slettes først (som GRUB gør på PC'en), så en mislykket prøve ikke prøves igen
# i ring — tjek sætter den igen, hvis versionen skal prøves en gang til.
proev() {
    [ "$PLATFORM" = pi ] || return 0
    local proev forrige
    # Kom vi tilbage fra en prøve, der ikke blev godkendt?
    forrige=$(env_hent proev_igang)
    if [ -n "$forrige" ] && [ "$SLOT" = "$(aktiv)" ]; then
        if [ "$(env_hent proev_startet)" = "$forrige" ]; then
            echo "Version $forrige blev prøvet, men ikke godkendt — kører den tidligere version."
        else
            echo "FEJL: Version $forrige blev aldrig startet — Pi'en understøtter måske ikke tryboot. Kører den tidligere version."
            env_saet sidste_fejl="$forrige blev ikke startet med tryboot $(date '+%Y-%m-%d %H:%M')"
        fi
        env_slet proev_igang proev_startet
    fi
    proev=$(env_hent proev)
    if [ -z "$proev" ] || [ "$proev" = "$SLOT" ] || [ "$SLOT" != "$(aktiv)" ]; then
        return 0
    fi
    if [ ! -s "$KORT/$proev/cmdline.txt" ]; then
        env_slet proev
        return 0
    fi
    local version
    version=$(env_hent proev_version)
    env_slet proev proev_startet
    env_saet proev_igang="$version"
    echo "Genstarter for at prøve version $version (system $proev) …"
    planlagt_genstart
    systemctl reboot "0 tryboot"
}

# ── bekraeft ───────────────────────────────────────────────
# Kører TV-siden? badminton-tv.service kører, og Chromium viser en side på
# http(s) — dvs. startsiden har fundet netværket og skiftet til TV_URL.
sund() {
    systemctl -q is-active badminton-tv.service || return 1
    curl -fs --max-time 5 "http://127.0.0.1:${BT_DEVTOOLS_PORT:-9222}/json/list" \
        | jq -e 'any(.[]; .type == "page" and (.url | test("^https?://")))' >/dev/null
}

rapport_koe() { # TYPE TEKST [LOGFIL] — en skærm-hændelse i rapportens kø
    BT_RAPPORT_LOG=${3:-} "$BT_LIB/rapport" koe "$1" "$2" "$(date +%s%3N)" >/dev/null 2>&1 || true
}

# Samme hændelse højst én gang i døgnet (tjek kører hver anden time)
MELDT=${BT_MELDT:-/var/lib/badminton-tv/opdatering-meldt}
meld_en_gang() { # TYPE TEKST [LOGFIL]
    local noegle nu sidst_noegle='' sidst=0
    noegle=$(printf '%s %s' "$1" "$2" | sha256sum | cut -c1-16)
    nu=$(date +%s)
    [ ! -f "$MELDT" ] || read -r sidst_noegle sidst < "$MELDT" || true
    if [ "$sidst_noegle" = "$noegle" ] && [ $((nu - ${sidst:-0})) -lt 86400 ]; then
        return 0
    fi
    rapport_koe "$@"
    mkdir -p "${MELDT%/*}"
    printf '%s %s\n' "$noegle" "$nu" > "$MELDT"
}

# Fejler den automatiske hentning, skal det kunne ses i admin (nr. 99) — før
# stod det kun i PC'ens journal. tjek køres i en ny proces (så gælder set -e i
# den), og ved en fejl lægges en skærm-hændelse (opd-fejl) i rapportens kø.
tjek_meld_fejl() {
    local log=$ARB/tjek.log kode=0 tekst
    mkdir -p "$ARB"
    # tee: linjerne står i journalen undervejs (en hentning tager minutter)
    BT_INDRE=1 "$BT_LIB/opdatering" tjek 2>&1 | tee "$log" || kode=${PIPESTATUS[0]}
    if [ "$kode" != 0 ]; then
        tekst=$(fejltekst "$log")
        meld_en_gang opd-fejl "Den automatiske opdatering fejlede: ${tekst#FEJL: }" "$log"
    fi
    exit "$kode"
}

# Kom vi tilbage fra en ny version, der ikke blev godkendt (nr. 99)? Så står
# proev_version (nyere end den kørende) uden proev: GRUB (PC) eller proev
# (Pi) har brugt forsøget, og det tidligere system kører igen. Før så ingen
# det — genstarten tilbage regnes som planlagt og meldes ikke. Nu meldes det
# én gang pr. forsøg som skærm-hændelse (opd-tilbage).
meld_tilbagerulning() {
    local pv antal fejl tekst
    pv=$(env_hent proev_version)
    { [ -n "$pv" ] && er_nyere "$VERSION_NU" "$pv"; } || return 0
    [ -z "$(env_hent proev)" ] || return 0          # venter stadig på at blive prøvet
    [ -z "$(env_hent proev_igang)" ] || return 0    # Pi: tryboot-genstarten er i gang
    antal=$(env_hent proev_antal)
    antal=${antal:-1}
    [ "$(env_hent proev_meldt)" != "$pv-$antal" ] || return 0
    tekst="Version $pv startede ikke rigtigt (forsøg $antal af $MAKS_FORSOEG) — kører $VERSION_NU igen."
    # sidste_fejl skrives af bekraeft (PC og Pi) og proev (Pi) og slettes
    # herunder, så den hører til netop dette forsøg
    fejl=$(env_hent sidste_fejl)
    case "$fejl" in
        "$pv "*tryboot*) tekst="$tekst Pi'en startede den ikke (tryboot virker måske ikke på denne model)." ;;
        "$pv "*) tekst="$tekst TV-siden kom ikke frem inden for $((FRIST_SEK / 60)) minutter." ;;
        *) tekst="$tekst Den gik i stå eller blev slukket under opstarten." ;;
    esac
    [ "$antal" -lt "$MAKS_FORSOEG" ] || tekst="$tekst Versionen opgives — venter på en nyere."
    echo "$tekst"
    rapport_koe opd-tilbage "$tekst"
    env_saet proev_meldt="$pv-$antal"
    env_slet sidste_fejl
}

bekraeft() {
    if ! paa_proeve; then
        meld_tilbagerulning
        return 0
    fi
    [ "$PLATFORM" = pi ] && env_saet proev_startet="$VERSION_NU"
    echo "System $SLOT (version $VERSION_NU) er startet på prøve. Det bliver det aktive system, når TV-siden har kørt i $SUND_SEK sekunder."
    # Oppetiden og ikke $SECONDS: den følger uret, som springer, når det
    # sættes fra internettet (set i testen: 2 timer — fristen "udløb" med det samme)
    oppe() { cut -d. -f1 /proc/uptime; }
    local start ok_fra=''
    start=$(oppe)
    while [ $(($(oppe) - start)) -lt "$FRIST_SEK" ]; do
        if sund; then
            ok_fra=${ok_fra:-$(oppe)}
            if [ $(($(oppe) - ok_fra)) -ge "$SUND_SEK" ]; then
                if [ "$PLATFORM" = pi ]; then
                    # Først config.txt (hvad firmwaren starter), så tilstanden
                    bt_pi_config "$KORT/config.txt" "$SLOT"
                    env_saet aktiv="$SLOT"
                    env_slet proev proev_version proev_antal proev_igang proev_startet proev_meldt
                else
                    env_saet aktiv="$SLOT"
                    env_slet proev proev_version proev_antal proev_meldt
                fi
                echo "Opdateret til version $VERSION_NU — system $SLOT er nu det aktive."
                return 0
            fi
        else
            ok_fra=''
        fi
        sleep 10
    done
    echo "FEJL: TV-siden kom ikke frem inden for $((FRIST_SEK / 60)) minutter med version $VERSION_NU — genstarter til det tidligere system."
    env_saet sidste_fejl="$VERSION_NU $(date '+%Y-%m-%d %H:%M')"
    planlagt_genstart
    systemctl reboot
}

# ── spoerg ─────────────────────────────────────────────────
# Kommer der nye versioner tit, når de skærme, der venter et døgn (auto), aldrig
# frem. Admin kan derfor bede en PC om at tage den nyeste med det samme
# (Adgangslinks → "Installér nyeste nu"). PC'en spørger serveren bag TV_URL med
# adgangslinkets token og melder tilbage, hvordan det gik — at den spørger,
# viser også admin, at den kan.

# meld [STATUS [TEKST [MÅL]]] — til serveren; svaret (JSON) på stdout
meld() {
    local data
    data=$(jq -nc --arg navn "$BT_NAVN" --arg v "$VERSION_NU" --arg s "${1:-}" --arg t "${2:-}" --arg m "${3:-}" \
        '{navn: $navn, kioskVersion: $v, status: $s, tekst: $t, maal: $m}')
    curl -fsS --proto '=https,http' --connect-timeout 15 --max-time 30 \
        -H 'Content-Type: application/json' -H "X-Adgangslink: $TOKEN" \
        -H 'User-Agent: badminton-tv-opdatering' --data-binary "$data" \
        "${BT_SPOERG_URL:-$SERVER/api/screens/pc-opdatering}"
}

# tjek i en ny proces, så set -e gælder i den (ikke i "… || kode=$?")
tjek_nu() { BT_NU=1 "$BT_LIB/opdatering" tjek; }

spoerg() {
    [ -n "$SLOT" ] || return 0
    paa_proeve && return 0    # først når den nye version er godkendt
    [ -f "$KIOSK_ENV" ] || return 0
    # TV_URL og NAVN (setup skriver dem %q-citeret)
    local BT_TV_URL='' BT_NAVN=''
    # shellcheck source=/dev/null
    . "$KIOSK_ENV"
    [[ "$BT_NAVN" =~ ^[a-z0-9][a-z0-9-]{0,59}$ ]] || return 0
    # Adgangslinket: https://klub.badmintonapp.dk/t/<token>
    [[ "$BT_TV_URL" =~ ^(https?://[^/?#]+)/t/([A-Za-z0-9_-]{8,128})/?$ ]] || return 0
    local SERVER=${BASH_REMATCH[1]} TOKEN=${BASH_REMATCH[2]} svar

    svar=$(meld) || return 0   # intet net — spørger igen om 2 minutter
    [ "$(jq -r '.opdater == true' <<<"$svar" 2>/dev/null)" = true ] || return 0

    echo "Admin har bedt om nyeste version nu."
    meld i-gang "Tjekker for en ny version …" >/dev/null || true
    mkdir -p "$ARB"
    rm -f "$ARB/udfald"
    local log=$ARB/nu.log kode=0 resultat sidste
    tjek_nu > "$log" 2>&1 || kode=$?
    cat "$log"
    resultat=$(cat "$ARB/udfald" 2>/dev/null || true)
    sidste=$(grep -v '^[[:space:]]*$' "$log" | tail -1 | cut -c1-300 || true)
    # Ved en fejl: den første FEJL-linje (fx "System b findes ikke på disken"),
    # og er det fejlfælden, med kommandoens egen besked forrest (fejltekst)
    [ "$kode" = 0 ] || sidste=$(fejltekst "$log")
    case "$resultat" in
        "klar "*)
            local v=${resultat#klar }
            meld genstarter "Version $v er klar — genstarter." "$v" >/dev/null || true
            echo "Genstarter for at starte version $v …"
            planlagt_genstart
            systemctl reboot ;;
        nyeste|fra|kan-ikke)
            meld "$resultat" "$sidste" >/dev/null || true ;;
        *)
            if [ "$kode" != 0 ]; then
                meld fejl "$sidste" >/dev/null || true
            else
                meld venter "$sidste" >/dev/null || true   # prøver igen om 2 minutter
            fi ;;
    esac
}

# ── status ─────────────────────────────────────────────────
status() {
    printf 'Kører: system %s, version %s%s\n' "${SLOT:-(gammelt layout)}" "$VERSION_NU" \
        "$(paa_proeve && echo ' — på prøve')"
    if [ "$PLATFORM" = pi ]; then
        [ -f "$PI_ENV" ] && grep -v '^#' "$PI_ENV"
    else
        [ -f "$BTENV" ] && grub-editenv "$BTENV" list
    fi
    return 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    trap 'echo "FEJL: linje $LINENO: $BASH_COMMAND (kode $?) — prøver igen næste gang."' ERR
    case "${1:-}" in
        tjek)
            # Én hentning ad gangen (timeren, slukningen og et manuelt kald).
            # Den indre proces (tjek_meld_fejl) har låsen fra den ydre.
            if [ -z "${BT_INDRE:-}" ]; then
                mkdir -p "$ARB"
                exec 9>"$ARB/laas"
                if ! flock -n 9; then
                    echo "En anden opdatering kører allerede."
                    exit 0
                fi
            fi
            # Bedt om fra admin (BT_NU): admin ser selv udfaldet (spoerg)
            if [ -n "${BT_NU:-}${BT_INDRE:-}" ]; then
                tjek
            else
                tjek_meld_fejl
            fi ;;
        proev)    proev ;;
        bekraeft) bekraeft ;;
        status)   status ;;
        spoerg)   spoerg ;;
        *) sed -n '2,39p' "$0"; exit 1 ;;
    esac
fi
