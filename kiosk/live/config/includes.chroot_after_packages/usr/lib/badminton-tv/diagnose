#!/bin/bash
# Skriver diagnose.txt, så netværksproblemer kan undersøges på en Windows-PC
# bagefter: på PC'en på USB-nøglen i prøvetilstand ("Test uden at
# installere"), på en Raspberry Pi på SD-kortet ved hver opstart.
#
# Skrives efter 1, 3 og 6 minutter (overskriver hver gang), så WiFi har haft
# tid til at prøve. WiFi-koden kommer aldrig med — kun dens længde og om den
# har mellemrum eller særlige tegn.

set -u
. /usr/lib/badminton-tv/conf.sh

MEDIE=/run/live/medium
PI_BOOT=/boot/firmware
UD=/run/badminton-tv/diagnose.txt

afsnit() { printf '\n===== %s =====\n' "$1"; }

rapport() {
    printf 'Badminton TV diagnose — %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'Version: %s\n' "$(cat /usr/share/badminton-tv/version 2>/dev/null || echo ukendt)"
    if [ -r /proc/device-tree/model ]; then
        printf 'Model: %s\n' "$(tr -d '\0' < /proc/device-tree/model)"
        printf 'RAM: %s MB\n' "$(awk '/MemTotal/ { print int($2 / 1024) }' /proc/meminfo)"
    fi
    if [ -r /sys/class/dmi/id/sys_vendor ]; then
        printf 'PC: %s %s (%s)\n' "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" \
            "$(cat /sys/class/dmi/id/product_version 2>/dev/null)" "$(cat /sys/class/dmi/id/product_name 2>/dev/null)"
    fi
    printf 'Kerne: %s, oppe i %s s\n' "$(uname -r)" "$(cut -d. -f1 /proc/uptime)"

    afsnit 'Vurdering'
    /usr/lib/badminton-tv/netstatus tekst

    # En Pi har intet batteri-ur: indtil uret er synkroniseret, står det på
    # sidst kendte tidspunkt (på et nyt SD-kort: da billedet blev bygget).
    # Den automatiske slukning venter også på synkroniseringen.
    afsnit 'Ur'
    if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = yes ]; then
        printf 'Synkroniseret med internettet: ja\n'
    else
        printf 'Synkroniseret med internettet: NEJ — tiden øverst er ikke den rigtige,\n'
        printf 'og automatisk slukning springes over, indtil der er forbindelse.\n'
    fi
    timedatectl 2>&1
    timedatectl timesync-status 2>&1 | grep -E 'Server|Poll|Packet count|Offset'

    afsnit 'kiosk.conf (WiFi-koden er skjult)'
    if conf=$(bt_find_conf); then
        bt_read_conf "$conf"
        printf 'TV_URL=%s\nWIFI_NAVN=[%s] (%s bytes)\n' "$BT_TV_URL" "$BT_WIFI_NAVN" "$(printf '%s' "$BT_WIFI_NAVN" | wc -c)"
        if [ -n "$BT_WIFI_KODE" ]; then
            local k=$BT_WIFI_KODE
            printf 'WIFI_KODE: %s tegn' "$(printf '%s' "$k" | wc -m)"
            [[ "$k" == *' '* ]] && printf ', indeholder mellemrum'
            [[ "$k" == ' '* ]] && printf ', STARTER med mellemrum'
            [[ "$k" == *' ' ]] && printf ', SLUTTER med mellemrum'
            LC_ALL=C grep -q '[^ -~]' <<<"$k" && printf ', indeholder tegn uden for ASCII (fx æøå)'
            printf '\n'
        else
            printf 'WIFI_KODE: tom\n'
        fi
        [ -n "$BT_FEJL" ] && printf 'Fejl: %s\n' "$BT_FEJL"
        [ -n "$BT_ADVARSLER" ] && printf 'Advarsler: %s\n' "$BT_ADVARSLER"
    else
        printf 'kiosk.conf blev ikke fundet\n'
    fi

    afsnit 'Netværkskort'
    lspci -nnk 2>/dev/null | grep -A3 -iE 'network|ethernet|wireless|wi-fi' || printf '(lspci fandt intet)\n'
    printf -- '-- USB --\n'
    lsusb 2>/dev/null || true
    printf -- '-- rfkill --\n'
    rfkill list 2>/dev/null || true

    afsnit 'NetworkManager'
    nmcli general 2>&1
    printf '\n'
    nmcli device 2>&1
    printf '\n-- Synlige WiFi-netværk --\n'
    nmcli -f SSID,BSSID,MODE,CHAN,FREQ,SIGNAL,SECURITY device wifi list 2>&1
    printf '\n-- Forbindelsen fra kiosk.conf --\n'
    nmcli -f connection.id,802-11-wireless.ssid,802-11-wireless.hidden,802-11-wireless-security.key-mgmt \
        connection show badminton-tv-wifi 2>&1
    printf '\n-- IP --\n'
    ip -br addr 2>&1
    ip route 2>&1
    iw reg get 2>/dev/null | head -3

    afsnit 'Kernen (WiFi og firmware)'
    dmesg 2>/dev/null | grep -iE 'iwlwifi|rtw|rtl8|r8169|mt76|mt79|ath1|ath9|brcm|firmware|wlan|wlp|e1000' | tail -60

    afsnit 'NetworkManager-log'
    journalctl -b -u NetworkManager -o short-monotonic --no-pager 2>/dev/null | tail -120

    afsnit 'wpa_supplicant-log'
    journalctl -b -u wpa_supplicant -o short-monotonic --no-pager 2>/dev/null | tail -80
}

skriv() {
    rapport > "$UD" 2>&1
    # Raspberry Pi: SD-kortets FAT-partition er altid skrivbar og læses på en
    # Windows-PC ved siden af kiosk.conf.
    if [ -f "$PI_BOOT/kiosk.conf" ] && mountpoint -q "$PI_BOOT"; then
        sed 's/$/\r/' "$UD" > "$PI_BOOT/diagnose.txt" && sync \
            && echo "diagnose.txt skrevet til SD-kortet"
        return 0
    fi
    mountpoint -q "$MEDIE" || return 0
    # Nøglen er monteret skrivebeskyttet. Den åbnes kun kort, så den kan tages
    # ud når som helst uden at blive beskadiget.
    if mount -o remount,rw "$MEDIE" 2>/dev/null; then
        sed 's/$/\r/' "$UD" > "$MEDIE/diagnose.txt" 2>/dev/null
        sync
        mount -o remount,ro "$MEDIE" 2>/dev/null
        echo "diagnose.txt skrevet til USB-nøglen"
    else
        echo "USB-nøglen kunne ikke skrives — diagnose ligger i $UD"
    fi
}

for vent in 60 120 180; do
    sleep "$vent"
    skriv
done
