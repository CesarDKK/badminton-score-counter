def log(tekst):
    print(f'[browservagt] {tekst}', flush=True)


def rod_disk():
    """Blokenheden bag / (fx /dev/nvme0n1p2), eller None (live-USB: overlay)."""
    try:
        with open('/proc/self/mountinfo') as f:
            for linje in f:
                felter = linje.split()
                if len(felter) > 4 and felter[4] == '/' and ' - ' in linje:
                    kilde = linje.split(' - ', 1)[1].split()[1]
                    return kilde if kilde.startswith('/dev/') else None
    except OSError:
        pass
    return None


def tjek_disk(fil):
    """None = disken svarer, ellers en fejlbeskrivelse. Læser uden om cachen."""
    buf = mmap.mmap(-1, 4096)       # sidejusteret, som O_DIRECT kræver
    try:
        try:
            fd = os.open(fil, os.O_RDONLY | os.O_DIRECT)
        except OSError as e:
            if e.errno != 22:       # EINVAL: filsystemet kan ikke O_DIRECT (test på tmpfs)
                return f'kan ikke åbne {fil}: {e.strerror}'
            fd = os.open(fil, os.O_RDONLY)
            os.posix_fadvise(fd, 0, 4096, os.POSIX_FADV_DONTNEED)
        try:
            n = os.preadv(fd, [buf], 0)
        finally:
            os.close(fd)
        if n < 1:
            return f'{fil} er tom'
    except OSError as e:
        return f'kan ikke læse {fil}: {e.strerror}'
    finally:
        buf.close()
    return None


# Kernens egne beskeder om disken — dem vil vi have med i dumpet.
DISK_MOENSTER = re.compile(r'nvme|\bata[0-9]|mmc[0-9]|mmcblk|pciehp|pcieport|blk_update_request'
                           r'|I/O error|EXT4-fs error|JBD2|Buffer I/O|Remounting', re.I)


def disklinje(post):
    """Beskeden i én /dev/kmsg-post ("<prio>,<nr>,<µs>,-;<besked>"), hvis den er
    en advarsel eller værre (prio <= 4) om disken — opstartens almindelige
    disk-linjer (info) og det døde filsystems gentagne EXT4-advarsler er ikke med."""
    hoved, _, tekst = post.decode(errors='replace').partition(';')
    try:
        prio = int(hoved.split(',', 1)[0]) & 7
    except ValueError:
        return None
    tekst = tekst.strip()
    if prio <= 4 and DISK_MOENSTER.search(tekst) and 'EXT4-fs warning' not in tekst:
        return tekst
    return None


def diskfejl_fra_kernen(maks=40):
    """De seneste kernebeskeder om disken, læst fra /dev/kmsg (ligger i RAM)."""
    linjer = []
    try:
        fd = os.open('/dev/kmsg', os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return linjer
    try:
        while True:
            try:
                post = os.read(fd, 8192)
            except BlockingIOError:
                break
            except OSError:         # EPIPE: bufferen løb over — læs videre
                continue
            if not post:
                break
            linje = disklinje(post)
            if linje:
                linjer.append(linje)
    finally:
        os.close(fd)
    return linjer[-maks:]


def genstart_pc_med_dump(aarsag):
    log(f'disken er død ({aarsag}) — udløser kernepanik, PC\'en genstarter')
    # Dumpet i pstore er kun de sidste par KB af kerneloggen, og et dødt
    # filsystem fylder den med gentagne EXT4-advarsler. Så gentag diskfejlene
    # lige før panikken — så står årsagen altid i "Hent fejllog".
    # Én write() pr. linje: kernen tager hver skrivning til /dev/kmsg som én
    # besked på højst 1 KB og afviser større (så ingen bufret fil her).
    try:
        linjer = diskfejl_fra_kernen()
        fd = os.open('/dev/kmsg', os.O_WRONLY)
        try:
            os.write(fd, f'browservagt: disken er død ({aarsag}) — udløser kernepanik\n'.encode()[:1000])
            for linje in linjer:
                os.write(fd, f'browservagt: tidligere: {linje}\n'.encode()[:1000])
        finally:
            os.close(fd)
    except Exception as e:          # noqa: BLE001 — må aldrig forhindre genstarten
        log(f'kunne ikke gentage kernens diskfejl: {e}')
    for tast in 'cb':               # c: panik med dump i pstore; b: nødgenstart, hvis c ikke virker
        try:
            with open(SYSRQ, 'w') as f:
                f.write(tast)
            time.sleep(30)          # panikken genstarter os inden da
        except OSError as e:
            log(f'sysrq {tast} fejlede: {e}')


def meld_genstart(problem):
    """Melder genstarten til serveren — i baggrunden, så vagten ikke venter på nettet."""
    if not MELD:
        return
    try:
        subprocess.Popen([MELD, 'meld', 'browser-genstart', problem],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        log(f'kunne ikke melde genstarten: {e}')


def sider():
    with urllib.request.urlopen(f'http://127.0.0.1:{PORT}/json/list', timeout=SVAR_TIMEOUT) as r:
        return json.load(r)


def evaluer(ws_url, udtryk):
    """Afvikler udtryk i siden og returnerer værdien (eller rejser en fejl)."""
    # ws://127.0.0.1:9222/devtools/page/<id>
    rest = ws_url.split('://', 1)[1]
    vaert, sti = rest.split('/', 1)
    host, port = vaert.split(':')
    s = socket.create_connection((host, int(port)), timeout=SVAR_TIMEOUT)
    try:
        noegle = base64.b64encode(os.urandom(16)).decode()
        s.sendall((f'GET /{sti} HTTP/1.1\r\nHost: {vaert}\r\nUpgrade: websocket\r\n'
                   f'Connection: Upgrade\r\nSec-WebSocket-Key: {noegle}\r\n'
                   'Sec-WebSocket-Version: 13\r\n\r\n').encode())
        svar = b''
        while b'\r\n\r\n' not in svar:
            del_ = s.recv(4096)
            if not del_:
                raise ConnectionError('forbindelsen lukket under håndtrykket')
            svar += del_
        if b' 101 ' not in svar.split(b'\r\n', 1)[0]:
            raise ConnectionError('websocket afvist: ' + svar.split(b'\r\n', 1)[0].decode(errors='replace'))
        rest_data = svar.split(b'\r\n\r\n', 1)[1]

        besked = json.dumps({'id': 1, 'method': 'Runtime.evaluate',
                             'params': {'expression': udtryk, 'returnByValue': True}}).encode()
        maske = os.urandom(4)
        hoved = bytes([0x81])
        n = len(besked)
        if n < 126:
            hoved += bytes([0x80 | n])
        elif n < 65536:
            hoved += bytes([0x80 | 126]) + struct.pack('>H', n)
        else:
            hoved += bytes([0x80 | 127]) + struct.pack('>Q', n)
        s.sendall(hoved + maske + bytes(b ^ maske[i % 4] for i, b in enumerate(besked)))

        buf = rest_data
        frist = time.monotonic() + SVAR_TIMEOUT

        def laes(antal):
            nonlocal buf
            while len(buf) < antal:
                if time.monotonic() > frist:
                    raise TimeoutError('siden svarede ikke')
                del_ = s.recv(65536)
                if not del_:
                    raise ConnectionError('forbindelsen lukket')
                buf += del_
            ud, buf = buf[:antal], buf[antal:]
            return ud

        while True:
            b1, b2 = laes(2)
            laengde = b2 & 0x7f
            if laengde == 126:
                laengde = struct.unpack('>H', laes(2))[0]
            elif laengde == 127:
                laengde = struct.unpack('>Q', laes(8))[0]
            data = laes(laengde)
            if b1 & 0x0f != 1:      # kun tekst-rammer er svar
                continue
            msg = json.loads(data)
            if msg.get('id') == 1:
                if 'error' in msg:
                    raise RuntimeError(msg['error'].get('message', 'fejl'))
                return msg.get('result', {}).get('result', {}).get('value')
    finally:
        s.close()


def tjek():
    """None = alt i orden (eller intet at tjekke), ellers en fejlbeskrivelse."""
    try:
        alle = sider()
    except Exception as e:
        return f'browseren svarer ikke ({e})'
    side = next((p for p in alle if p.get('type') == 'page'
                 and str(p.get('url', '')).startswith(('http://', 'https://'))), None)
    if not side:
        return None                     # startsiden/fejlside — startsiden tager sig af det
    try:
        vaerdi = evaluer(side['webSocketDebuggerUrl'],
                         '[Date.now(), window.__btTik || 0, document.visibilityState]')
    except Exception as e:
        return f'TV-siden svarer ikke ({e}) — {side.get("url", "")[:80]}'
    if isinstance(vaerdi, list) and len(vaerdi) >= 2 and vaerdi[1]:
        alder = vaerdi[0] - vaerdi[1]
        # Er TV'et slukket (intet display), regner Chromium siden for skjult og
        # kan bremse dens timere — det er ikke en frysning, og ingen ser
        # skærmen. Genstart ville bare starte forfra hvert minut.
        if alder > TIK_MAX_ALDER_MS and (len(vaerdi) < 3 or vaerdi[2] != 'hidden'):
            return f'TV-sidens hjerteslag har stået stille i {round(alder / 1000)} s'
    return None


# ── Net-vagt ──────────────────────────────────────────────

def server_fra_kiosk_env():
    """Serveren bag TV_URL (https://klub.badmintonapp.dk), eller None."""
    try:
        ud = subprocess.run(['bash', '-c', '. "$1" 2>/dev/null; printf %s "${BT_TV_URL:-}"', 'bash', KIOSK_ENV],
                            capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.match(r'^(https?://[^/?#\s]+)', ud)
    return m.group(1) if m else None


def server_svarer(server):
    """Svarer serveren overhovedet? Et HTTP-svar (også 404/503) tæller — kun
    ingen forbindelse (DNS, timeout, intet net) er et nej."""
    try:
        with urllib.request.urlopen(f'{server}/health', timeout=8):
            return True
    except urllib.error.HTTPError:
        return True
    except Exception:              # noqa: BLE001 — alt andet er "ingen forbindelse"
        return False


def router():
    """Standard-gatewayens IP fra /proc/net/route, eller None (ingen IP/rute)."""
    try:
        with open('/proc/net/route') as f:
            for linje in f.readlines()[1:]:
                felter = linje.split()
                if len(felter) > 3 and felter[1] == '00000000' and int(felter[3], 16) & 2:
                    return socket.inet_ntoa(struct.pack('<I', int(felter[2], 16)))
    except (OSError, ValueError):
        pass
    return None


def router_svarer():
    """Kan PC'en nå sin egen router? Et kort TCP-forsøg — et afslag (RST) er
    også et svar — eller en færdig ARP-post for routeren efter forsøget.
    (Ingen ping på PC'en, og mange routere svarer ikke på ping alligevel.)"""
    gw = router()
    if not gw:
        return False
    for port in (53, 80, 443):
        try:
            socket.create_connection((gw, port), timeout=2).close()
            return True
        except ConnectionRefusedError:
            return True
        except OSError:
            pass
    try:
        with open('/proc/net/arp') as f:
            for linje in f.readlines()[1:]:
                felter = linje.split()
                if felter and felter[0] == gw and int(felter[2], 16) & 2 and felter[3] != '00:00:00:00:00:00':
                    return True
    except (OSError, ValueError, IndexError):
        pass
    return False


def wifi_kort_svarer_ikke():
    """Intel AC 8265 efter Windows: "probe … failed with error -110" — kun at
    trække strømstikket ud hjælper (set 2026-10-01), så genstart er nytteløst."""
    try:
        ud = subprocess.run(['journalctl', '-k', '-b', '-q', '-n', '1', '--no-pager', '-g',
                             'failed with error -110'], capture_output=True, text=True, timeout=10).stdout
        return bool(ud.strip())
    except (OSError, subprocess.SubprocessError):
        return False


def genforbind_wifi():
    """WiFi fra og til, og forbind igen (eller hele netværket, hvis der ikke
    er WiFi — fx et kabel)."""
    def nm(*args, timeout=15):
        try:
            subprocess.run(['nmcli', *args], capture_output=True, timeout=timeout)
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        wifi = 'badminton-tv-wifi' in subprocess.run(['nmcli', '-t', '-f', 'NAME', 'connection', 'show'],
                                                     capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        wifi = False
    if wifi:
        nm('radio', 'wifi', 'off')
        time.sleep(3)
        nm('radio', 'wifi', 'on')
        time.sleep(3)
        nm('connection', 'up', 'id', 'badminton-tv-wifi', timeout=45)
    else:
        nm('networking', 'off')
        time.sleep(3)
        nm('networking', 'on')


def pc_er_optaget():
    """Er den automatiske slukning eller opdatering i gang? Så ingen genstart."""
    for enhed in ('badminton-tv-sluk.service', 'badminton-tv-opdatering.service'):
        try:
            if subprocess.run(['systemctl', 'is-active', '--quiet', enhed], timeout=10).returncode == 0:
                return True
        except (OSError, subprocess.SubprocessError):
            pass
    return False


def koe_haendelse(type_, tekst, fra, til=None):
    """Lægger en hændelse i rapportens kø (sendes, når nettet er tilbage)."""
    if not MELD:
        return
    args = [MELD, 'koe', type_, tekst, str(int(fra * 1000))] + ([str(int(til * 1000))] if til else [])
    try:
        subprocess.run(args, capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        log(f'kunne ikke lægge hændelsen i kø: {e}')


def send_koeen():
    if MELD:
        try:
            subprocess.Popen([MELD, 'send'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass


def kl(t):
    return time.strftime('%H.%M', time.localtime(t))


def varighed(sek):
    sek = int(sek)
    return f'{sek} s' if sek < 90 else f'{round(sek / 60)} min'


class Netvagt:
    """Tilstanden mellem tjekkene. Funktionerne kan udskiftes (tests)."""

    def __init__(self, server, ur=time.time, server_ok=server_svarer, lokal_ok=router_svarer,
                 kortfejl=wifi_kort_svarer_ikke, genforbind=genforbind_wifi, genstart=None,
                 optaget=pc_er_optaget, koe=koe_haendelse, send=send_koeen, tilstand_fil=NET_TILSTAND):
        self.server, self.ur = server, ur
        self.server_ok, self.lokal_ok, self.kortfejl = server_ok, lokal_ok, kortfejl
        self.genforbind, self.optaget, self.koe, self.send = genforbind, optaget, koe, send
        self.genstart = genstart or self._genstart_pc
        self.tilstand_fil = tilstand_fil
        t = self._laes()
        self.raekke = int(t.get('raekke', 0))     # genstarter i træk uden at nettet kom igen
        self.nede_fra = None                       # serveren kan ikke nås siden
        self.lokal_nede_fra = None                 # routeren kan heller ikke nås siden
        self.var_lokal_nede = False
        self.genforbundet = False
        self.kort_meldt = False
        self.ok_fra = self.ur()

    def _laes(self):
        try:
            with open(self.tilstand_fil) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def _gem(self):
        try:
            os.makedirs(os.path.dirname(self.tilstand_fil), exist_ok=True)
            with open(self.tilstand_fil + '.ny', 'w') as f:
                json.dump({'raekke': self.raekke}, f)
            os.replace(self.tilstand_fil + '.ny', self.tilstand_fil)
        except OSError as e:
            log(f'net-vagt: kunne ikke gemme tilstanden: {e}')

    def _genstart_pc(self):
        try:
            os.makedirs(os.path.dirname(NEDLUKNING), exist_ok=True)
            with open(NEDLUKNING, 'w') as f:
                f.write('netvagt\n')      # allerede meldt — rapporten skal ikke melde den igen
        except OSError:
            pass
        subprocess.run(PC_GENSTART, shell=True, check=False)

    def tik(self):
        nu = self.ur()
        if self.server_ok(self.server):
            self._tilbage(nu)
            return
        if self.nede_fra is None:
            self.nede_fra = nu
            log(f'net-vagt: kan ikke nå {self.server}')
        if self.lokal_ok():
            # Hallens net virker (routeren svarer) — internettet eller serveren
            # er nede. Det hjælper ikke at genstarte.
            if self.lokal_nede_fra is not None:
                log('net-vagt: routeren svarer igen (serveren gør ikke endnu)')
            self.lokal_nede_fra = None
            return
        if self.lokal_nede_fra is None:
            self.lokal_nede_fra = nu
            self.var_lokal_nede = True
            log('net-vagt: kan heller ikke nå routeren — PC\'ens egen forbindelse er væk')
        nede = nu - self.lokal_nede_fra

        if nede >= NET_GENFORBIND and (self.kort_meldt or self.kortfejl()):
            if not self.kort_meldt:
                self.kort_meldt = True
                log('net-vagt: WiFi-kortet svarer ikke (error -110) — genstart hjælper ikke')
                self.koe('net-kort', 'WiFi-kortet svarer ikke (error -110). Sluk PC\'en og træk '
                         'strømstikket ud i 1 minut — en genstart hjælper ikke', self.lokal_nede_fra)
            return
        if nede >= NET_GENFORBIND and not self.genforbundet:
            self.genforbundet = True
            log(f'net-vagt: ingen forbindelse i {varighed(nede)} — slår WiFi fra og til')
            self.genforbind()
            return
        if self.raekke >= len(NET_GENSTART):
            return                          # opgivet, til nettet har virket en halv time
        if nede >= NET_GENSTART[self.raekke] and not self.optaget():
            self.raekke += 1
            self._gem()
            tekst = (f'Ingen WiFi-forbindelse i {varighed(nede)} (fra kl. {kl(self.lokal_nede_fra)}), '
                     f'heller ikke efter at WiFi blev slået fra og til — PC\'en genstartes '
                     f'(genstart {self.raekke} i træk)')
            log(f'net-vagt: {tekst}')
            self.koe('net-genstart', tekst, self.lokal_nede_fra, nu)
            self.genstart()

    def _tilbage(self, nu):
        if self.nede_fra is not None:
            nede = nu - self.nede_fra
            log(f'net-vagt: forbindelsen er tilbage efter {varighed(nede)}')
            if nede >= 60:
                if self.var_lokal_nede:
                    hvordan = ('efter at WiFi blev slået fra og til' if self.genforbundet
                               else 'af sig selv')
                    self.koe('net-wifi', f'WiFi-forbindelsen var væk i {varighed(nede)} '
                             f'(kl. {kl(self.nede_fra)}–{kl(nu)}) og kom igen {hvordan}', self.nede_fra, nu)
                else:
                    self.koe('net-server', f'Ingen forbindelse til serveren i {varighed(nede)} '
                             f'(kl. {kl(self.nede_fra)}–{kl(nu)}), men hallens netværk virkede',
                             self.nede_fra, nu)
                self.send()
            self.ok_fra = nu
        self.nede_fra = self.lokal_nede_fra = None
        self.var_lokal_nede = self.genforbundet = False
        if self.raekke and nu - self.ok_fra >= NET_STABIL:
            log('net-vagt: nettet har virket en halv time — genstarter tælles forfra')
            self.raekke = 0
            self._gem()


def main():
    if 'BT_DISK' in os.environ:
        disk = os.environ['BT_DISK'] or None
    else:
        disk = DISK_FIL if rod_disk() else None
    server = server_fra_kiosk_env() if os.environ.get('BT_NETVAGT', '1') != '0' else None
    netvagt = Netvagt(server) if server else None
    log(f'startet — første tjek om {OPSTART_PAUSE} s, derefter hvert {INTERVAL}. sekund'
        + (f'; disk-vagt på {disk} ({rod_disk() or "?"})' if disk else '; ingen disk-vagt')
        + (f'; net-vagt mod {server}' if netvagt else '; ingen net-vagt'))
    time.sleep(OPSTART_PAUSE)
    fejl = 0
    diskfejl = 0
    while True:
        if netvagt:
            try:
                netvagt.tik()
            except Exception as e:      # noqa: BLE001 — net-vagten må aldrig stoppe browser-vagten
                log(f'net-vagt: fejl: {e}')
        if disk:
            problem = tjek_disk(disk)
            if problem:
                diskfejl += 1
                log(f'diskfejl {diskfejl}/{FEJL_FOER_GENSTART}: {problem}')
                if diskfejl >= FEJL_FOER_GENSTART:
                    genstart_pc_med_dump(problem)
                    diskfejl = 0
            elif diskfejl:
                log('disken svarer igen')
                diskfejl = 0
        problem = tjek()
        if problem:
            fejl += 1
            log(f'fejl {fejl}/{FEJL_FOER_GENSTART}: {problem}')
            if fejl >= FEJL_FOER_GENSTART:
                log('genstarter browseren')
                subprocess.run(GENSTART, shell=True, check=False)
                meld_genstart(problem)
                fejl = 0
                time.sleep(OPSTART_PAUSE)
                continue
        elif fejl:
            log('TV-siden svarer igen')
            fejl = 0
        time.sleep(INTERVAL)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
