# Force LF line endings for files that run on Linux
*.sh text eol=lf
*.sql text eol=lf
Dockerfile* text eol=lf
nginx.conf text eol=lf
avahi-daemon.conf text eol=lf
*.service text eol=lf

# Windows files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Auto-detect the rest
* text=auto

# Badminton TV USB-nøglen: alt under kiosk/live ender i et Linux-system, også
# scripts uden .sh-endelse. Tekstfilerne til USB-nøglen får CRLF i buildet.
kiosk/** text eol=lf
