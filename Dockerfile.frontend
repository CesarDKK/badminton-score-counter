FROM nginx:alpine

# Copy custom nginx config + shared security-header snippet (included per location)
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf

# Copy app frontend files
COPY frontend/ /usr/share/nginx/html/

# Copy marketing site files
COPY marketing/ /usr/share/nginx/marketing/

# Copy football marketing site
COPY football-app/marketing/ /usr/share/nginx/football-marketing/

# Copy provebillede.dk (statisk SVG-prøvebillede)
COPY provebillede/ /usr/share/nginx/provebillede/

# Copy statistik.badmintonapp.dk (klubstatistik — backend er stats-backend)
COPY stats/frontend/ /usr/share/nginx/statistik/

# Copy planner.badmintonapp.dk (tidsplanlægger — rent statisk, se docs/planner-design.md)
COPY planner/index.html planner/planner.css planner/tp-bundle.js /usr/share/nginx/planner/
COPY planner/src/ /usr/share/nginx/planner/src/

# Share fonts from app into marketing sites (fonts.css lives in marketing/ and is reused by football)
RUN cp -r /usr/share/nginx/html/fonts /usr/share/nginx/marketing/fonts \
    && cp -r /usr/share/nginx/html/fonts /usr/share/nginx/football-marketing/fonts \
    && cp /usr/share/nginx/marketing/fonts.css /usr/share/nginx/football-marketing/fonts.css \
    && cp -r /usr/share/nginx/html/fonts /usr/share/nginx/statistik/fonts \
    && cp /usr/share/nginx/marketing/fonts.css /usr/share/nginx/statistik/fonts.css \
    && cp -r /usr/share/nginx/html/fonts /usr/share/nginx/planner/fonts \
    && cp /usr/share/nginx/marketing/fonts.css /usr/share/nginx/planner/fonts.css

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
